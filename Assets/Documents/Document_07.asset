  m_Name: Document_07
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  documentId: DOC_007
  documentNumber: "\u0414\u041E\u041A\u041B\u0410\u0414 \u2116 002"
  documentTitle: "\u041E\u0437\u0435\u0440\u043D\u043E\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
  documentText: "\u041E\u0431\u044A\u0435\u043A\u0442 \u0431\u044B\u043B \u0437\u0430\u043C\u0435\u0447\u0435\u043D
    \u0432 \u0440\u0430\u0439\u043E\u043D\u0435 [[\u043E\u0437\u0435\u0440\u0430
    \u041B\u043E\u0445-\u041D\u0435\u0441\u0441]] \u0432 4:20 \u043F\u043E \u043C\u0435\u0441\u0442\u043D\u043E\u043C\u0443
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438.\n\n\u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0435\u043C
    \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u043B \u043C\u0435\u0441\u0442\u043D\u044B\u0439
    \u0440\u044B\u0431\u0430\u043A, \u043E\u043D \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442
    \u0447\u0442\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u043B\u043E
    [[\u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 12 \u043C\u0435\u0442\u0440\u043E\u0432
    \u0432 \u0434\u043B\u0438\u043D\u043D\u0443]].\n\n\u0410\u0433\u0435\u043D\u0442\u044B
    \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438, \u043F\u0440\u0438\u0431\u044B\u0432\u0448\u0438\u0435
    \u043D\u0430 \u043C\u0435\u0441\u0442\u043E, \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438
    \u043A\u043E\u043D\u0442\u0430\u043A\u0442 \u0441\u043E \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0435\u043C.
    \u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C \u0431\u044B\u043B \u0434\u043E\u043F\u0440\u043E\u0448\u0435\u043D
    \u0438 [[\u043B\u0438\u043A\u0432\u0438\u0434\u0438\u0440\u043E\u0432\u0430\u043D]].
    \u0412 \u0445\u043E\u0434\u0435 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0433\u043E
    \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F,
    \u0431\u044B\u043B\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E
    [[6 \u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445
    \u043E\u0441\u043E\u0431\u0435\u0439]]. \u0410\u0433\u0435\u043D\u0442\u044B
    \u043E\u0440\u0441\u043D\u043E\u0432\u0430\u043B\u0438 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u043D\u0443\u044E
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0443\u044E
    \u0431\u0430\u0437\u0443 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044E\u0442
    \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 \u0437\u0430 \u0440\u0430\u0439\u043E\u043D\u043E\u043C. "
