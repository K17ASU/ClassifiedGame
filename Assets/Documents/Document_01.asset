  m_Script: {fileID: 11500000, guid: d3ef4614fdfd89049bb2af4a160e869c, type: 3}
  m_Name: Document_01
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  documentId: DOC_001
  documentNumber: "\u0412\u0412\u041E\u0414\u041D\u0410\u042F \u0427\u0410\u0421\u0422\u042C"
  documentTitle: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435"
  documentText: "\"2 \u043C\u0430\u044F 1933 \u0433\u043E\u0434\u0430 \u0432 \u0421\u0435\u0432\u0435\u0440\u043E-\u0428\u043E\u0442\u043B\u0430\u043D\u0434\u0441\u043A\u043E\u043C
    \u043D\u0430\u0433\u043E\u0440\u044C\u0435 \u043C\u0435\u0441\u0442\u043D\u0430\u044F
    \u0433\u0430\u0437\u0435\u0442\u0430 Inverness Courier \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B\u0430
    \u0437\u0430\u043C\u0435\u0442\u043A\u0443 \u043E \u0441\u0443\u043F\u0440\u0443\u0433\u0430\u0445
    {{\u041C\u0430\u043A\u043A\u0435\u0439}}, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438 \u0432 \u0432\u043E\u0434\u0430\u0445
    \u043E\u0437\u0435\u0440\u0430 [uv]\u041B\u043E\u0445-\u041D\u0435\u0441\u0441[/]
    \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435,
    \u043F\u043E\u0445\u043E\u0436\u0435\u0435 \u043D\u0430 \u043A\u0438\u0442\u0430.\n\n\u041F\u043E\u0441\u043B\u0435
    \u0442\u043E\u0433\u043E \u043A\u0430\u043A \u043D\u043E\u0432\u043E\u0441\u0442\u044C
    \u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0431\u0438\u0440\u0430\u0442\u044C
    \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C, \u043D\u0430
    \u043C\u0435\u0441\u0442\u043E \u0431\u044B\u043B\u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B
    \u0430\u0433\u0435\u043D\u0442\u044B [uv]\u0411\u044E\u0440\u043E[/]. \u041A\u043E\u043D\u0442\u0430\u043A\u0442
    \u0441 \u0441\u0443\u043F\u0440\u0443\u0433\u0430\u043C\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C, \u043D\u043E \u0431\u044B\u043B\u0438
    \u0434\u043E\u043F\u0440\u043E\u0448\u0435\u043D\u044B \u0434\u0440\u0443\u0433\u0438\u0435
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0438.\n\n\u041F\u043E
    \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E
    \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u043B\u043E \u043E\u043A\u043E\u043B\u043E
    10 \u043C\u0435\u0442\u0440\u043E\u0432 \u0432 \u0434\u043B\u0438\u043D\u0443,
    \u0438\u043C\u0435\u043B\u043E \u0448\u0435\u044E [redact,uv]\u0441 \u0448\u0435\u0440\u0441\u0442\u044C\u044E
    \u0438\u043B\u0438 \u0432\u043E\u043B\u043E\u0441\u0430\u043C\u0438[/], \u0441\u0443\u0436\u0430\u044E\u0449\u0443\u044E\u0441\u044F
    \u043A \u0433\u043E\u043B\u043E\u0432\u0435, \u0438 \u0441\u043F\u0438\u043D\u0443
    [redact,uv]\u0441 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438
    \u0433\u043E\u0440\u0431\u0430\u043C\u0438[/]. \u041F\u043E\u0441\u043B\u0435
    \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0440\u0430\u0437\u0432\u0435\u0434\u044B\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0438 \u0430\u0433\u0435\u043D\u0442\u044B
    [uv]\u0411\u044E\u0440\u043E[/] \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438
    \u043D\u0430 \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u044C\u0435 \u043E\u0437\u0435\u0440\u0430
    5 \u0442\u0435\u043B \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u0436\u0438\u0442\u0435\u043B\u0435\u0439,
    \u043E\u0434\u0435\u0442\u044B\u0445 \u0432 \u0440\u043E\u0431\u044B. \u0422\u0435\u043B\u0430
    \u0431\u044B\u043B\u0438 \u0443\u043B\u043E\u0436\u0435\u043D\u044B \u0442\u0430\u043A\u0438\u043C
    \u043E\u0431\u0440\u0430\u0437\u043E\u043C, \u0447\u0442\u043E \u043F\u0440\u0438
    \u0432\u0437\u0433\u043B\u044F\u0434\u0435 \u0441\u0432\u0435\u0440\u0445\u0443
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u044B\u0432\u0430\u043B\u0438 [uv]\u043F\u044F\u0442\u0438\u043A\u043E\u043D\u0435\u0447\u043D\u0443\u044E
    \u0437\u0432\u0435\u0437\u0434\u0443[/]. \u0421\u043B\u0435\u0434\u044B \u043D\u0430
    \u0431\u0435\u0440\u0435\u0433\u0443 \u0432\u0435\u043B\u0438 \u043E\u0442 \u043C\u0435\u0441\u0442\u0430
    \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0442\u0435\u043B
    \u043A \u0432\u043E\u0434\u0435; \u043E\u0431\u0440\u0430\u0442\u043D\u044B\u0445
    \u0441\u043B\u0435\u0434\u043E\u0432 \u043D\u0435 \u0431\u044B\u043B\u043E.\n\n\u041F\u043E\u0441\u043B\u0435
    \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0442\u0435\u043B
    \u0430\u0433\u0435\u043D\u0442\u044B \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
    \u0432\u044B\u0439\u0442\u0438 \u043D\u0430 \u0441\u0432\u044F\u0437\u044C \u0441
    \u043E\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u043C\u0438 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044F\u043C\u0438,
    \u043D\u043E \u0442\u0435 \u0432\u0435\u043B\u0438 \u0441\u0435\u0431\u044F \u043A\u0440\u0430\u0439\u043D\u0435
    \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E: \u0432\u044B\u043A\u0440\u0438\u043A\u0438\u0432\u0430\u043B\u0438
    [redact,uv]\u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0435 \u0444\u0440\u0430\u0437\u044B[/]
    \u0438 \u043D\u0430\u043F\u0430\u043B\u0438 \u043D\u0430 \u0430\u0433\u0435\u043D\u0442\u043E\u0432
    \u0411\u044E\u0440\u043E.\n\n\u0411\u044E\u0440\u043E \u043F\u0440\u0438\u0448\u043B\u043E
    \u043A \u0432\u044B\u0432\u043E\u0434\u0443, \u0447\u0442\u043E \u0432 \u0434\u0430\u043D\u043D\u043E\u043C
    \u0440\u0435\u0433\u0438\u043E\u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u044F\u0447\u0435\u0439\u043A\u0430 [[\u043F\u043E\u043A\u0430 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
    \u043A\u0443\u043B\u044C\u0442\u0430]].\n\""
