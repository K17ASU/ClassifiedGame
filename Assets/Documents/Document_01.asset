  m_Name: Document_01
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  documentNumber: "\u0412\u0412\u041E\u0414\u041D\u0410\u042F \u0427\u0410\u0421\u0422\u042C"
  documentTitle: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435"
  documentText: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C,
    [[\u0410\u0433\u0435\u043D\u0442]].\n\n\u0412\u0430\u0448\u0435\u0439 \u0437\u0430\u0434\u0430\u0447\u0435\u0439
    \u0431\u0443\u0434\u0435\u0442 [[\u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u0442\u044C]]
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B, \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439
    \u043D\u0430\u043B\u0438\u0447\u0438\u044F \u0432 \u043D\u0438\u0445 \u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u044B\u0445
    \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439. \u041A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u044B\u0435
    \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0431\u0443\u0434\u0443\u0442
    [[\u0432\u044B\u0434\u0435\u043B\u044F\u0442\u044C\u0441\u044F]] \u043D\u0430
    \u0444\u043E\u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u0434\u0430\u043D\u043D\u044B\u0445 \u0432 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435."
