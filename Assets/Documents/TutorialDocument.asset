  documentNumber: "\u0412\u0412\u041E\u0414\u041D\u0410\u042F \u0427\u0410\u0421\u0422\u042C"
  documentTitle: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435"
  documentText: "\u0421\u041B\u0423\u0416\u0415\u0411\u041D\u0410\u042F \u0417\u0410\u041F\u0418\u0421\u041A\u0410\r\n\r\n\u0410\u0433\u0435\u043D\u0442
    [[Username]] \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\r\n\u0432
    [[\u0426\u0435\u043D\u0442\u0440 \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438
    \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438]].\r\n\r\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043D\u0430 \u0441\u043B\u043E\u0432\u043E, \u0447\u0442\u043E\u0431\u044B \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u043F\u043B\u0430\u0448\u043A\u0443.\r\n\r\n\u0427\u0442\u043E\u0431\u044B \u0437\u0430\u043A\u0440\u044B\u0442\u044C
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0432
    \u043F\u043E\u0434\u0440\u044F\u0434,\r\n\u0437\u0430\u0436\u043C\u0438\u0442\u0435
    \u043B\u0435\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438
    \u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435 \u043F\u043E \u0442\u0435\u043A\u0441\u0442\u0443.\r\n\r\n\u0417\u0430\u043A\u0440\u043E\u0439\u0442\u0435
    \u0438\u043C\u044F \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430
    \u0438 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u0430,\r\n\u0437\u0430\u0442\u0435\u043C
    \u043F\u0435\u0440\u0435\u0434\u0430\u0439\u0442\u0435 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442
    \u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443."
