  documentId: DOC_002
  documentNumber: "\u0414\u041E\u041A\u041B\u0410\u0414 \u2116 001"
  documentTitle: "\u0423\u0421\u0422\u0420\u041E\u0419\u0421\u0422\u0412\u041E \u041E\u0420\u0413\u0410\u041D\u0418\u0417\u0410\u0426\u0418\u0418"
  documentText: "\"\u0425\u0438\u043C\u0438\u043E\u0442\u0440\u0430\u0441\u0441\u044B
    (\u0445\u0438\u043C\u0442\u0440\u0435\u0439\u043B\u044B) - \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u0430\u044F
    \u0442\u0435\u043E\u0440\u0438\u044F \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0430.
    \u0421\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043A\u0438 \u043C\u0438\u0444\u0430
    \u0441\u0447\u0438\u0442\u0430\u044E\u0442, \u0447\u0442\u043E \u0431\u0435\u043B\u044B\u0435
    \u043F\u043E\u043B\u043E\u0441\u044B \u0432 \u043D\u0435\u0431\u0435 \u043E\u0442
    \u0441\u0430\u043C\u043E\u043B\u0451\u0442\u043E\u0432 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0441\u043B\u0435\u0434\u0430\u043C\u0438 [redact,magnifier]\u0442\u0430\u0439\u043D\u043E\u0433\u043E
    \u0440\u0430\u0441\u043F\u044B\u043B\u0435\u043D\u0438\u044F \u0445\u0438\u043C\u0438\u043A\u0430\u0442\u043E\u0432[/]
    \u0434\u043B\u044F \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F \u043A\u043B\u0438\u043C\u0430\u0442\u0430
    [redact,uv]\u0438\u043B\u0438 \u043B\u044E\u0434\u0435\u0439[/].\n\n\u042D\u0442\u0430
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0431\u044B\u043B\u0430
    \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0430
    \u0430\u0433\u0435\u043D\u0442\u0430\u043C\u0438 [uv]\u0411\u044E\u0440\u043E[/]
    \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043D\u043E\u0432\u043E\u0441\u0442\u0438
    \u043E \u0445\u0438\u043C\u0442\u0440\u0435\u0439\u043B\u0430\u0445 \u0441\u0442\u0430\u043B\u0438
    \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B \u0441\u0440\u0435\u0434\u0438
    \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F \u0438 \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u043E\u0432.
    \u041F\u043E \u0434\u0430\u043D\u043D\u044B\u043C \u0438\u0437 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0445
    \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432, [redact,magnifier]\u043D\u0438
    \u043E\u0434\u0438\u043D \u0441\u0430\u043C\u043E\u043B\u0451\u0442[/], \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0439
    \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0439 \u0441\u043B\u0435\u0434, \u043D\u0435
    \u0447\u0438\u0441\u043B\u0438\u0442\u0441\u044F \u043D\u0438 \u0432 \u043E\u0434\u043D\u043E\u0439
    \u0430\u0432\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439 \u0431\u0430\u0437\u0435
    \u0434\u0430\u043D\u043D\u044B\u0445. \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    [redact,uv]\u0431\u043E\u0440\u0442\u043E\u0432\u044B\u0435 \u043D\u043E\u043C\u0435\u0440\u0430
    \u0441\u0430\u043C\u043E\u043B\u0451\u0442\u043E\u0432[/] \u0442\u0430\u043A\u0436\u0435
    \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C.\n\n14 \u0434\u0435\u043A\u0430\u0431\u0440\u044F
    2000 \u0433\u043E\u0434\u0430 \u0430\u0433\u0435\u043D\u0442\u0430\u043C \u0411\u044E\u0440\u043E
    \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0441\u043B\u0435\u0434\u0438\u0442\u044C
    \u043E\u0434\u0438\u043D \u0438\u0437 \u0442\u0430\u043A\u0438\u0445 \u0441\u0430\u043C\u043E\u043B\u0451\u0442\u043E\u0432
    \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u0411\u041F\u041B\u0410
    \u043A\u043B\u0430\u0441\u0441\u0430 \"\"\u041E\u041A\u041E \u0421\u041E\u041B\u041D\u0426\u0410\"\".
    \u0421\u0430\u043C\u043E\u043B\u0451\u0442 \u043B\u0435\u0442\u0435\u043B \u0438\u0437
    [magnifier]\u0412\u0430\u0448\u0438\u043D\u0433\u0442\u043E\u043D\u0430[/] \u0432
    [uv]\u042D\u0434\u0438\u043D\u0431\u0443\u0440\u0433[/] \u0438 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B
    \u0430\u0432\u0438\u0430\u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \"\"[redact,uv,magnifier]Starborne
    Airlines[/]\"\" \u043F\u043E\u0434 \u0431\u043E\u0440\u0442\u043E\u0432\u044B\u043C
    \u043D\u043E\u043C\u0435\u0440\u043E\u043C N 10202. \u041D\u0438\u043A\u0430\u043A\u043E\u0439
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \u043E\u0431 \u044D\u0442\u043E\u0439
    \u0430\u0432\u0438\u0430\u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u043D\u0430\u0439\u0434\u0435\u043D\u043E
    \u043D\u0435 \u0431\u044B\u043B\u043E.\n\n\u042D\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u0439
    \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0441\u043B\u0443\u0447\u0430\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    [redact,uv,magnifier]\u043A\u0443\u043B\u044C\u0442\u0430[/] \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438
    \u0428\u043E\u0442\u043B\u0430\u043D\u0434\u0438\u0438, \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0411\u044E\u0440\u043E.\n\""
