  m_Name: Document_03
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  documentId: DOC_003
  documentNumber: "\u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422 \u2116003"
  documentTitle: "\u0411\u041E\u041B\u042C\u0428\u0418\u0415 \u041B\u042E\u0414\u0418"
  documentText: "\"\u0412 2002 \u0433\u043E\u0434\u0443 \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B
    \u043D\u0430 \u0441\u0430\u0439\u0442\u0435 Worth1000 \u0444\u043E\u0442\u043E\u043C\u043E\u043D\u0442\u0430\u0436
    \"\"[uv]\u0440\u0430\u0441\u043A\u043E\u043F\u043E\u043A \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u043E\u0433\u043E
    \u0441\u043A\u0435\u043B\u0435\u0442\u0430[/]\"\". \u041A\u0430\u0440\u0442\u0438\u043D\u043A\u0430
    \u0440\u0430\u0437\u043E\u0448\u043B\u0430\u0441\u044C \u043F\u043E \u043C\u0438\u0440\u0443
    \u043A\u0430\u043A \u0441\u0435\u043D\u0441\u0430\u0446\u0438\u044F.\n\n\u0418\u0418-\u0430\u0433\u0435\u043D\u0442\u044B
    \u0411\u044E\u0440\u043E \u043D\u0430\u0447\u0430\u043B\u0438 \u043F\u043E\u043C\u0435\u0447\u0430\u0442\u044C
    \u044D\u0442\u0443 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
    \u043A\u0430\u043A \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E
    \u043E\u043F\u0430\u0441\u043D\u0443\u044E, \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E
    \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u0432\u044B\u0439\u0442\u0438
    \u043D\u0430 \u0441\u0432\u044F\u0437\u044C \u0441 \u0430\u0432\u0442\u043E\u0440\u043E\u043C.
    \u0410\u0432\u0442\u043E\u0440 \u0441\u043E\u043E\u0431\u0449\u0438\u043B, \u0447\u0442\u043E
    \u0440\u0430\u043D\u044C\u0448\u0435 \u044F\u0432\u043B\u044F\u043B\u0441\u044F
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u043C [uv]\u0421\u043C\u0438\u0442\u0441\u043E\u043D\u043E\u0432\u0441\u043A\u043E\u0433\u043E
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430[/], \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u044F\u043A\u043E\u0431\u044B \u043F\u0440\u044F\u0447\u0435\u0442 \u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442
    [redact,magnifier]\u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435 \u0441\u043A\u0435\u043B\u0435\u0442\u044B
    \u043B\u044E\u0434\u0435\u0439-\u0433\u0438\u0433\u0430\u043D\u0442\u043E\u0432[/],
    \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043C\u0435\u043D\u044F\u0442\u044C
    [redact,uv]\u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0438 \u0438\u0441\u0442\u043E\u0440\u0438\u0438[/].\n\n\u0410\u0433\u0435\u043D\u0442\u044B
    \u0411\u044E\u0440\u043E \u043F\u0440\u0438\u0431\u044B\u043B\u0438 \u0432 [uv]\u041D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    \u043C\u0443\u0437\u0435\u0439 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0438\u0441\u0442\u043E\u0440\u0438\u0438[/] \u0432 \u0412\u0430\u0448\u0438\u043D\u0433\u0442\u043E\u043D\u0435
    \u0441 \u0446\u0435\u043B\u044C\u044E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E. \u0418\u0445 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B
    \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440 \u043C\u0443\u0437\u0435\u044F
    [redact]\u0420\u0443\u043F\u0435\u0440\u0442 \u041B\u0435\u0439\u043D[/], \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0432 \u0445\u043E\u0434\u0435 \u0434\u043E\u043F\u0440\u043E\u0441\u0430 \u0441\u043E\u043E\u0431\u0449\u0438\u043B
    \u043A\u0440\u0430\u0439\u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0432\u044B\u0435
    \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0438 \u043E\u0442\u043A\u0430\u0437\u0430\u043B
    \u0430\u0433\u0435\u043D\u0442\u0430\u043C \u0432 \u0434\u043E\u0441\u0442\u0443\u043F\u0435
    \u043A \u0430\u0440\u0445\u0438\u0432\u0430\u043C.\n\n\u041F\u0440\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u043C
    \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u0438\u0438 \u043C\u0443\u0437\u0435\u044F
    [redact]\u0420\u0443\u043F\u0435\u0440\u0442 \u041B\u0435\u0439\u043D[/] \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D
    \u043D\u0435 \u0431\u044B\u043B, \u0430 \u0432 \u0435\u0433\u043E \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435
    \u043D\u0430\u0448\u043B\u0438 [redact,uv]\u0436\u0435\u0442\u043E\u043D[/] \u0441
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C [redact,magnifier]\u043F\u044F\u0442\u0438\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439
    \u0437\u0432\u0435\u0437\u0434\u044B[/].\n\n\u0411\u044E\u0440\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u043E
    \u0441\u0432\u044F\u0437\u044C \u043C\u0435\u0436\u0434\u0443 \u0441\u0443\u0431\u044A\u0435\u043A\u0442\u043E\u043C
    \u0438 [redact,uv,magnifier]\"\"\u041A\u0443\u043B\u044C\u0442\u043E\u043C \u0417\u0432\u0435\u0437\u0434\u043E\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u044B\u0445\"\"[/].\""
