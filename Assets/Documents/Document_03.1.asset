  m_Name: Document_03.1
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  documentId: TUT_002
  documentNumber: "\u0414\u041E\u041A\u041B\u0410\u0414 \u2116 002"
  documentTitle: "\u041E\u0437\u0435\u0440\u043D\u043E\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E"
  documentText: "\"\u0412\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435
    \u0441\u0435\u0431\u044F, {PLAYER_NAME}.\n\n\u0412 \u0441\u0432\u044F\u0437\u0438
    \u0441 \u0440\u043E\u0441\u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0430 \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u0432
    \u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u043E\u0434\u043E\u0431\u0440\u0438\u043B\u043E
    \u0432\u044B\u0434\u0430\u0447\u0443 \u043D\u043E\u0432\u043E\u0433\u043E \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430
    - [bold]\u0434\u0435\u043A\u043E\u0434\u0435\u0440\u0430[/].\n\n\u0414\u0435\u043A\u043E\u0434\u0435\u0440
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u044B\u044F\u0432\u043B\u044F\u0442\u044C
    \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
    [bold]\"\"\u0428\u0418\u0424\u0420\"\"[/] \u0438 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0442\u044C
    \u0441\u043A\u0440\u044B\u0442\u043E\u0435 \u0432 \u043D\u0451\u043C \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435.\n\n\u0412
    \u0432\u0430\u0448\u0435 [redact]\u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0435[/]
    \u0432\u044B\u0434\u0430\u043D \u0434\u0435\u043A\u043E\u0434\u0435\u0440. \u0414\u043B\u044F
    \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B
    \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u0435\u0433\u043E \u043D\u0430
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u0444\u0440\u0430\u0437\u0443:\n\n[decoder=\u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0435]\u0412\u0421\u0401
    \u0422\u0410\u0419\u041D\u041E\u0415 \u0421\u0422\u0410\u041D\u0415\u0422 \u042F\u0412\u042C\u042E[/]\n\n\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u044C\u0442\u0435
    \u0441\u043B\u043E\u0432\u043E, \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0435
    \u0432 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0435.\n\n[bold]\u0412\u0410\u0416\u041D\u041E[/]:
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435, \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u043E\u0435
    \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u0434\u0435\u043A\u043E\u0434\u0435\u0440\u0430,
    \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439. \u0412\u0430\u0448\u0435
    \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u0438\u043C\u0435\u0435\u0442 \u0441\u0430\u043C\u044B\u0439
    \u0432\u044B\u0441\u043E\u043A\u0438\u0439 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442.\n\""
