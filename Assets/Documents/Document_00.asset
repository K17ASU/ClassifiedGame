  m_Script: {fileID: 11500000, guid: d3ef4614fdfd89049bb2af4a160e869c, type: 3}
  m_Name: Document_00
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  documentId: DOC_000
  documentNumber: 
  documentTitle: 
  documentText: "\"\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430
    \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    {{\u041E\u0442\u0434\u0435\u043B \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
    \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438}} - \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u043D\u0438\u0435
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u043F\u0435\u0440\u0435\u0434
    \u0438\u0445 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0435\u0439 \u0432 {{\u0426\u0435\u043D\u0442\u0440
    \u0414\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438}}.\n\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442
    [bold]\"\"\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B\"\"[/],
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
    \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B \u0442\u043E\u043B\u044C\u043A\u043E
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    [bold]\u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432[/].
    \u0412\u0441\u0435 \u0432\u0430\u0448\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
    \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432 \u043F\u0440\u0430\u0432\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u044D\u043A\u0440\u0430\u043D\u0430.\n\n\u0412
    \u0441\u0432\u044F\u0437\u0438 \u0441 \u0440\u043E\u0441\u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0430
    \u0442\u0430\u043A\u0438\u0445 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u0432
    (\u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u0432\u043D\u0443\u0442\u0440\u0438
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438 \u0411\u044E\u0440\u043E)
    \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442
    \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C [redact,uv]\u0432\u0440\u0443\u0447\u043D\u0443\u044E
    \u043E\u0442\u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C\u0438[/] \u0411\u044E\u0440\u043E.\n_______________________\n\n\u0412
    \u0434\u0430\u043D\u043D\u043E\u043C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435
    \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0439
    \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442 - [bold]\"\"\u0421\u043A\u0440\u044B\u0442\u0430\u044F
    \u043C\u0435\u0442\u043A\u0430\"\"[/], \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u044F\u0432\u0438\u0442\u044C \u043F\u0440\u0438
    \u043F\u043E\u043C\u043E\u0449\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430
    [bold]\u0443\u043B\u044C\u0442\u0440\u0430\u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u043E\u0439
    \u043B\u0430\u043C\u043F\u044B (\u0423\u0424-\u041B\u0410\u041C\u041F\u042B)[/].\n\n\u0421\u043A\u0440\u044B\u0442\u044B\u0435
    \u043C\u0435\u0442\u043A\u0438 [bold]\u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F
    \u0446\u0432\u0435\u0442\u043E\u043C[/] \u043E\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0442\u0435\u043A\u0441\u0442\u0430.\n\n\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u0439\u0442\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0442
    \u0437\u0430\u0434\u0430\u043D\u0438\u044E \u043A \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0443.
    \u0417\u0430\u0434\u0430\u043D\u0438\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0432 \u043B\u0435\u0432\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u044D\u043A\u0440\u0430\u043D\u0430.\""
