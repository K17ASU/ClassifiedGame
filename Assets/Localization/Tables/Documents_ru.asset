    m_Metadata:
      m_Items: []
  - m_Id: 10913412364185612
    m_Localized: "\u0418\u0421\u0425\u041E\u0414\u042F\u0429\u0418\u0419 \u0421\u0418\u0413\u041D\u0410\u041B:
      \u041A\u0420\u0418\u0422\u0418\u0427\u0415\u0421\u041A\u0418\u0419\n\n\u042D\u041A\u0420\u0410\u041D\u0418\u0420\u041E\u0412\u0410\u041D\u0418\u0415:
      \u041D\u0415\u0414\u041E\u0421\u0422\u0410\u0422\u041E\u0427\u041D\u041E\n\n\u041A\u041E\u0420\u0420\u0415\u041A\u0426\u0418\u042F
      \u041E\u0420\u0411\u0418\u0422\u042B: \u0412\u042B\u041F\u041E\u041B\u041D\u042F\u0415\u0422\u0421\u042F\n\n\u041A\u041E\u0420\u0420\u0415\u041A\u0426\u0418\u042F
      \u041E\u0420\u0411\u0418\u0422\u042B: \u041E\u0428\u0418\u0411\u041A\u0410\n\n\u041F\u0420\u0415\u0414\u0415\u041B
      \u0420\u0415\u0417\u041E\u041D\u0410\u041D\u0421\u0410 \u041F\u0420\u0415\u0412\u042B\u0428\u0415\u041D\n\n\u0412\u041D\u0415\u0428\u041D\u0418\u0419
      \u0421\u0418\u0413\u041D\u0410\u041B \u041E\u0411\u041D\u0410\u0420\u0423\u0416\u0415\u041D\n\n[decoder=\u041C\u042B
      \u0412\u0418\u0414\u0418\u041C \u0422\u0415\u0411\u042F]\u0421\u0418\u041D\u0425\u0420\u041E\u041D\u0418\u0417\u0410\u0426\u0418\u042F[/]\n\n[decoder=\u0422\u042B
      \u0421\u041E\u0411\u0420\u0410\u041B \u041D\u0410\u0421]\u0421\u041C\u041E\u0422\u0420\u0418\u0422\u0415\u041B\u042C[/]\n\n[decoder=\u0414\u0412\u0415\u0420\u042C
      \u041E\u0422\u041A\u0420\u042B\u0422\u0410]\u0421\u0418\u0413\u041D\u0410\u041B
      \u041F\u0420\u0418\u041D\u042F\u0422[/]"
