  - m_Id: 266127087812609
    m_Localized: "\u0411\u041E\u041B\u042C\u0428\u0418\u0415 \u041B\u042E\u0414\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 266127087812610
    m_Localized: "\u0412 {{2002}} \u0433\u043E\u0434\u0443 \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B
      \u043D\u0430 \u0441\u0430\u0439\u0442\u0435 {{Worth1000}} \u0444\u043E\u0442\u043E\u043C\u043E\u043D\u0442\u0430\u0436
      [[\xAB\u0440\u0430\u0441\u043A\u043E\u043F\u043E\u043A \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u043E\u0433\u043E
      \u0441\u043A\u0435\u043B\u0435\u0442\u0430\xBB]]. \u041A\u0430\u0440\u0442\u0438\u043D\u043A\u0430
      \u0440\u0430\u0437\u043E\u0448\u043B\u0430\u0441\u044C \u043F\u043E \u043C\u0438\u0440\u0443
      \u043A\u0430\u043A \u0441\u0435\u043D\u0441\u0430\u0446\u0438\u044F.\n\n\u0418\u0418
      \u0410\u0433\u0435\u043D\u0442\u044B \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438,
      \u043D\u0430\u0447\u0430\u043B\u0438 \u043F\u043E\u043C\u0435\u0447\u0430\u0442\u044C
      \u044D\u0442\u0443 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u043A\u0430\u043A [[\u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E
      \u043E\u043F\u0430\u0441\u043D\u0443\u044E]], \u043F\u043E\u0441\u043B\u0435
      \u0447\u0435\u0433\u043E \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
      \u0432\u044B\u0439\u0442\u0438 \u043D\u0430 \u0441\u0432\u044F\u0437\u044C
      \u0441 \u0430\u0432\u0442\u043E\u0440\u043E\u043C. \u0410\u0432\u0442\u043E\u0440
      \u0441\u043E\u043E\u0431\u0449\u0438\u043B, \u0447\u0442\u043E \u0440\u0430\u043D\u044C\u0448\u0435
      \u044F\u0432\u043B\u044F\u043B\u0441\u044F \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u043C
      {{\u0421\u043C\u0438\u0442\u0441\u043E\u043D\u043E\u0432\u0441\u043A\u043E\u0433\u043E}}
      \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u044F\u043A\u043E\u0431\u044B \u043F\u0440\u044F\u0447\u0435\u0442 \u0438
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441\u043A\u0435\u043B\u0435\u0442\u044B [[\u043B\u044E\u0434\u0435\u0439-\u0433\u0438\u0433\u0430\u043D\u0442\u043E\u0432]],
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043C\u0435\u043D\u044F\u0442\u044C
      [[\u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0438 \u0438\u0441\u0442\u043E\u0440\u0438\u0438]].\n\n\u0410\u0433\u0435\u043D\u0442\u044B
      \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438
      \u041D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u043C\u0443\u0437\u0435\u0439
      \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
      \u0448\u0442\u0430\u0442\u0430 ((\u0412\u0430\u0448\u0438\u043D\u0433\u0442\u043E\u043D)),
      \u0441 \u0446\u0435\u043B\u044C\u044E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E. \u0418\u0445
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B \u0412\u0420\u0418\u041E \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430
      \u043C\u0443\u0437\u0435\u044F {{\u041F\u0438\u0442\u0435\u0440 \u041F\u0435\u0434\u0438\u0433\u0440\u044E}},
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432 \u0445\u043E\u0434\u0435
      \u0434\u043E\u043F\u0440\u043E\u0441\u0430 \u0441\u043E\u043E\u0431\u0449\u0430\u043B
      \u043A\u0440\u0430\u0439\u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0432\u044B\u0435
      \u0444\u0430\u043A\u0442\u044B \u0438 \u043E\u0442\u043A\u0430\u0437\u0430\u043B
      \u0430\u0433\u0435\u043D\u0442\u0430\u043C \u0432 \u0434\u043E\u043F\u0443\u0441\u043A\u0435
      \u043A \u0430\u0440\u0445\u0438\u0432\u0430\u043C \u043C\u0443\u0437\u0435\u044F.\n\n\u0412
      \u0445\u043E\u0434\u0435 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0433\u043E
      \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F,
      \u0430\u0433\u0435\u043D\u0442\u044B \u0443\u0437\u043D\u0430\u043B\u0438,
      \u0447\u0442\u043E {{\u041F\u0438\u0442\u0435\u0440 \u041F\u0435\u0434\u0438\u0433\u0440\u044E}}
      \u043D\u0435 \u0447\u0438\u0441\u043B\u0438\u0442\u0441\u044F \u0432 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445
      \u0434\u0430\u043D\u043D\u044B\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
      \u043C\u0443\u0437\u0435\u044F. \u041F\u0440\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u043C
      \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u0438\u0438 \u043C\u0443\u0437\u0435\u044F,
      \u0441\u0443\u0431\u044A\u0435\u043A\u0442 \u043D\u0435 \u0431\u044B\u043B
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D, \u0430 \u0432 \u0435\u0433\u043E
      \u043E\u0444\u0438\u0441\u0435 \u0431\u044B\u043B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D
      \u0436\u0435\u0442\u043E\u043D \u0441 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C
      [[\u043F\u044F\u0442\u0438\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439
