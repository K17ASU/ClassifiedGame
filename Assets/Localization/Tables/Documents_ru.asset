  - m_Id: 10837141630300163
    m_Localized: "\u041F\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u043C
      \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432 \u0410\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u041E\u0442\u0434\u0435\u043B \u0432\u044B\u044F\u0432\u0438\u043B \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0438\u0435\u0441\u044F
      \u0441\u0432\u044F\u0437\u0438 \u043C\u0435\u0436\u0434\u0443 \u0434\u0435\u043B\u0430\u043C\u0438,
      \u0440\u0430\u043D\u0435\u0435 \u0441\u0447\u0438\u0442\u0430\u0432\u0448\u0438\u043C\u0438\u0441\u044F
      \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u043C\u0438.\n\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
      \u0441\u0430\u043D\u043A\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D
      \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u0430\u0440\u0445\u0438\u0432\u043D\u044B\u043C
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C, \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u043C
      \u0441 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
      \"\u041A\u0443\u043B\u044C\u0442\u0430 \u0417\u0432\u0435\u0437\u0434\u043E\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u044B\u0445\".\n\u0414\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0435
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u0431\u0443\u0434\u0443\u0442
      \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u0432\u0430\u043C
      \u043D\u0435 \u0432 \u0445\u0440\u043E\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435, \u0430 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u043E\u0439
      \u0432\u0437\u0430\u0438\u043C\u043E\u0441\u0432\u044F\u0437\u0438.\n\n\u0412
      1952 \u0433\u043E\u0434\u0443 [redact]\u0414\u0436\u043E\u0440\u0434\u0436
      \u0412\u0430\u043D \u0422\u0430\u0441\u0441\u0435\u043B[/] \u0441\u043E\u043E\u0431\u0449\u0438\u043B,
      \u0447\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435
      \u043E\u0442 \u0432\u043D\u0435\u0437\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430
      \u043F\u043E \u0438\u043C\u0435\u043D\u0438 [redact,magnifier]\"\u0410\u0448\u0442\u0430\u0440\"[/].
      \u041F\u043E \u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430\u043C, [redact]\u0410\u0448\u0442\u0430\u0440[/]
      \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F [redact,magnifier]\u0432\u044B\u0441\u043E\u043A\u043E\u0440\u0430\u0437\u0432\u0438\u0442\u044B\u043C
      \u0434\u0443\u0445\u043E\u0432\u043D\u044B\u043C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C
      \u0438\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F[/],
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u044E\u0449\u0438\u043C [uv]\"\u0413\u0430\u043B\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0435\u0439 \u0421\u0432\u0435\u0442\u0430\"[/].
      \u0426\u0435\u043B\u044C\u044E \u0410\u0448\u0442\u0430\u0440\u0430 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0430\u0441\u044C
      [redact,uv]\u043F\u043E\u043C\u043E\u0449\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0443
      \u0432 \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0439 \u044D\u0432\u043E\u043B\u044E\u0446\u0438\u0438[/].
      \u0424\u0438\u0433\u0443\u0440\u0430 [redact]\u0410\u0448\u0442\u0430\u0440\u0430[/]
      \u0441\u0442\u0430\u043B\u0430 \u043A\u0443\u043B\u044C\u0442\u043E\u0432\u043E\u0439
      \u0432 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438 [magnifier]\u041D\u044C\u044E-\u042D\u0439\u0434\u0436[/]
      \u0438 [uv]\"\u0440\u0435\u043B\u0438\u0433\u0438\u044F\u0445 \u041D\u041B\u041E\"[/].\n\n\u0412
      \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445 \u0443\u0447\u0435\u043D\u0438\u044F\u0445
      \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442\u0441\u044F [magnifier]\"\u0417\u0432\u0435\u0437\u0434\u043D\u044B\u0435
      \u0412\u043B\u0430\u0434\u044B\u043A\u0438\"[/] - \u0434\u0443\u0445\u043E\u0432\u043D\u044B\u0435
      \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430,
      \u043A \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043E\u0442\u043D\u043E\u0441\u044F\u0442
      \u0438 [redact]\u0410\u0448\u0442\u0430\u0440\u0430[/]. \u042D\u0442\u043E\u0442
      \u0442\u0435\u0440\u043C\u0438\u043D \u0442\u0430\u043A\u0436\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0441\u044F
      \u0432 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044F\u0445 [redact,uv,magnifier]\"\u041A\u0443\u043B\u044C\u0442\u0430
      \u0417\u0432\u0435\u0437\u0434\u043E\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u044B\u0445\"[/],
