  - m_Id: 1737425055956994
    m_Localized: "{{30}} \u0430\u043F\u0440\u0435\u043B\u044F {{2018}} \u0433\u043E\u0434\u0430
      \u0432 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u0438
      Twitter \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u0441\u0435\u0440\u0438\u044F
      \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u0439 \u043E\u0442 [redact]\u0430\u043A\u043A\u0430\u0443\u043D\u0442\u0430[/]
      [redact,decoder,uv=\u041C\u0430\u0439\u043B\u0437 \u041C\u0430\u0440\u0448]\"TheSunVanished\"[/].
      \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F \u043F\u043E\u0437\u0434\u043D\u043E
      \u0443\u0442\u0440\u043E\u043C, \u043D\u043E [magnifier,redact]\u0441\u043E\u043B\u043D\u0446\u0430[/]
      \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u0438\u0434\u043D\u043E. \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C
      \u0434\u0435\u043B\u0438\u043B\u0441\u044F \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F\u043C\u0438
      \u0438 \u0432\u0438\u0434\u0435\u043E \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B
      \u043E \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u0445, \u043F\u0430\u043D\u0438\u043A\u0435
      \u0438 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044F\u0445 [uv,redact]\u043C\u0438\u0440\u0430
      \u0431\u0435\u0437 \u0441\u043E\u043B\u043D\u0446\u0430[/].\n\n\u041F\u043E\u0441\u043B\u0435
      \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0441\u0435\u0440\u0438\u0438 \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u0439
      \u0418\u0418-\u0430\u0433\u0435\u043D\u0442\u044B \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
      [magnifier,redact]\u0437\u0430\u0431\u0438\u043B\u0438 \u0442\u0440\u0435\u0432\u043E\u0433\u0443[/]
      \u0438 \u0441\u043E\u043E\u0431\u0449\u0438\u043B\u0438 \u043E \u0441\u043E\u0431\u044B\u0442\u0438\u0438
      \u043A\u043B\u0430\u0441\u0441\u0430 [decoder=\u0430\u043A\u043A\u0430\u0443\u043D\u0442]\"\u0421\u043B\u0438\u044F\u043D\u0438\u0435\"[/].
      \u0410\u0433\u0435\u043D\u0442\u044B \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
      \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0441\u0432\u044F\u0437\u044C \u0441 \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u0435\u043C
      [redact]\u0430\u043A\u043A\u0430\u0443\u043D\u0442\u0430[/], \u043D\u043E \u0432\u0441\u0435
      \u0438\u0445 \u043F\u043E\u043F\u044B\u0442\u043A\u0438 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0442\u0449\u0435\u0442\u043D\u044B \u0438\u0437-\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043A\u043E\u043C\u043C\u0435\u043D\u0442\u0430\u0440\u0438\u0435\u0432
      \u043F\u043E\u0434 \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u044F\u043C\u0438
      \u0438 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u044F
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438.\n\n\u041F\u0440\u0438
      \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C \u0430\u043D\u0430\u043B\u0438\u0437\u0435
      \u0431\u044B\u043B\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E,
      \u0447\u0442\u043E \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0435 \u0432
      [uv,redact]\u0442\u0435\u043A\u0443\u0449\u0435\u0439 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438[/],
      \u0430 \u0435\u0433\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u0432 \u043D\u0430\u0448\u0443
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F [magnifier,redact]\u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u043C\u0443
      \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044E[/]. \u0420\u0435\u0448\u0435\u043D\u0438\u0435\u043C
      \u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u043B\u044E\u0431\u043E\u0435
      \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u0441 [redact]\u0430\u043A\u043A\u0430\u0443\u043D\u0442\u043E\u043C[/] \u0441\u043E
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
      \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E.
      \u0420\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F. \n"
