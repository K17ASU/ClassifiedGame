  - m_Id: 10895718273331210
    m_Localized: "\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u044C\u0442\u0435:\r\n\r\n\u2022
      \u0410\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B\r\n\u2022
      \u0421\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0435
      \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F
      \u0438 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u044F
      \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438\r\n\u2022
      \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E
      \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0411\u044E\u0440\u043E\r\n\r\n\u041D\u0435
      \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u0439\u0442\u0435:\r\n\r\n\u2022
      \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u043E\u0431\u0449\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0445
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439 \u0438 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u044B\u0445
