  m_TableData:
  - m_Id: 2300068806656
    m_Localized: "\u0423\u0427\u0415\u0411\u041D\u042B\u0419 \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 2300131721216
    m_Localized: "\u041F\u041E\u0420\u042F\u0414\u041E\u041A \u0417\u0410\u0421\u0415\u041A\u0420\u0415\u0427\u0418\u0412\u0410\u041D\u0418\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915520
    m_Localized: "\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u044C\u0442\u0435
      \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u044F,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915521
    m_Localized: "\u0421\u041B\u0423\u0416\u0415\u0411\u041D\u0410\u042F \u0417\u0410\u041F\u0418\u0421\u041A\u0410\n\n\u0414\u043E\u0431\u0440\u043E
      \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C \u0432 \u0411\u044E\u0440\u043E
      \u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438,
      \u0430\u0433\u0435\u043D\u0442 {PLAYER_NAME}.\n\n\u0412\u044B \u0431\u0443\u0434\u0435\u0442\u0435
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443
      \u0432 {{\u041E\u0442\u0434\u0435\u043B \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
      \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438}}.\n_______________________\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u0442\u0435\u043A\u0441\u0442\u0430,
      \u0447\u0442\u043E\u0431\u044B [bold]\u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u0438\u0442\u044C[/]
      \u0435\u0433\u043E \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438
      [bold]\u043C\u0430\u0440\u043A\u0435\u0440\u0430[/].\n\u0427\u0442\u043E\u0431\u044B
      \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u0438\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u0432 \u043F\u043E\u0434\u0440\u044F\u0434,
      \u0437\u0430\u0436\u043C\u0438\u0442\u0435 \u043B\u0435\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443
      \u043C\u044B\u0448\u0438 \u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435
      \u043F\u043E \u0442\u0435\u043A\u0441\u0442\u0443.\n\n\u0412\u044B \u0442\u0430\u043A\u0436\u0435
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u043C\u0435\u0442\u0438\u0442\u044C
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u0442\u0435\u043A\u0441\u0442\u0430
      [bold]\u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u043E\u043C[/], \u0435\u0441\u043B\u0438
      \u0432\u044B \u0432 \u043D\u0451\u043C \u043D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D\u044B,
      \u043D\u043E \u043F\u043E\u043A\u0430 \u043D\u0435 \u0433\u043E\u0442\u043E\u0432\u044B
      \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u0438\u0442\u044C. \u0422\u0435\u043A\u0441\u0442,
      \u043F\u043E\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u043E\u043C,
      \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0438 [bold]\u043D\u0435 \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F[/]
      \u043F\u0440\u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0435 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430
      \u043D\u0430 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0443.\n\n\u0427\u0442\u043E\u0431\u044B
      \u0443\u0431\u0440\u0430\u0442\u044C \u0442\u0435\u043A\u0443\u0449\u0438\u0439
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u0438 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043D\u0430 \u043C\u0430\u0440\u043A\u0435\u0440,
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u0443\u044E
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438.\n\n\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u044C\u0442\u0435
      \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u044F,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B, \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0439\u0442\u0435
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443,
      \u043D\u0430\u0436\u0430\u0432 \u043A\u043D\u043E\u043F\u043A\u0443 \"\u041F\u0415\u0420\u0415\u0414\u0410\u0422\u042C
      \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422\" \u0432 \u043D\u0438\u0436\u043D\u0435\u043C
      \u043F\u0440\u0430\u0432\u043E\u043C \u0443\u0433\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915525
    m_Localized: "\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u044C\u0442\u0435:\n\n\u2022
      \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0445
      \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439
      \u0411\u044E\u0440\u043E\n\u2022 \u0410\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0435
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915524
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430
      \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u044F
      {{\u041E\u0442\u0434\u0435\u043B \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
      \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438}} - \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u043D\u0438\u0435
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u043F\u0435\u0440\u0435\u0434
      \u0438\u0445 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0435\u0439 \u0432
      {{\u0426\u0435\u043D\u0442\u0440 \u0414\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438}}.\n\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442
      [bold]\"\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B\"[/],
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445
      [bold]\u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432[/].
      \u0412\u0441\u0435 \u0432\u0430\u0448\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
      \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432 \u043F\u0440\u0430\u0432\u043E\u0439
      \u0447\u0430\u0441\u0442\u0438 \u044D\u043A\u0440\u0430\u043D\u0430.\n\n\u0412
      \u0441\u0432\u044F\u0437\u0438 \u0441 \u0440\u043E\u0441\u0442\u043E\u043C
      \u0447\u0438\u0441\u043B\u0430 \u0442\u0430\u043A\u0438\u0445 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u0432
      (\u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u0432\u043D\u0443\u0442\u0440\u0438
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438 \u0411\u044E\u0440\u043E)
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442
      \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C [redact,uv]\u0432\u0440\u0443\u0447\u043D\u0443\u044E
      \u043E\u0442\u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D
      \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C\u0438[/]
      \u0411\u044E\u0440\u043E.\n_______________________\n\n\u0412 \u0434\u0430\u043D\u043D\u043E\u043C
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435 \u0438\u043C\u0435\u0435\u0442\u0441\u044F
      \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
      - [bold]\"\u0421\u043A\u0440\u044B\u0442\u0430\u044F \u043C\u0435\u0442\u043A\u0430\"[/],
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u044F\u0432\u0438\u0442\u044C
      \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430
      [bold]\u0443\u043B\u044C\u0442\u0440\u0430\u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u043E\u0439
      \u043B\u0430\u043C\u043F\u044B (\u0423\u0424-\u041B\u0410\u041C\u041F\u042B)[/].\n\n\u0421\u043A\u0440\u044B\u0442\u044B\u0435
      \u043C\u0435\u0442\u043A\u0438 [bold]\u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F
      \u0446\u0432\u0435\u0442\u043E\u043C[/] \u043E\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0442\u0435\u043A\u0441\u0442\u0430.\n\n\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u0439\u0442\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0442
      \u0437\u0430\u0434\u0430\u043D\u0438\u044E \u043A \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0443.
      \u0417\u0430\u0434\u0430\u043D\u0438\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432 \u043B\u0435\u0432\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u044D\u043A\u0440\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915522
    m_Localized: "\u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422 \u2116000"
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915523
    m_Localized: "\u0414\u041E\u041B\u0416\u041D\u041E\u0421\u0422\u041D\u0410\u042F
      \u0418\u041D\u0421\u0422\u0420\u0423\u041A\u0426\u0418\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 253372523921408
    m_Localized: "\u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422 \u2116000.1"
    m_Metadata:
      m_Items: []
  - m_Id: 253372599418880
    m_Localized: "\u041B\u0418\u0427\u041D\u041E\u0415 \u0421\u041E\u041E\u0411\u0429\u0415\u041D\u0418\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 253372599418881
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      {PLAYER_NAME}.\n\n\u0418\u0437\u0443\u0447\u0438\u0432 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u0438\u0437 \u0432\u0430\u0448\u0435\u0433\u043E
      \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430,
      \u0411\u044E\u0440\u043E \u043F\u0440\u0438\u043D\u044F\u043B\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B
      \u0432 \u0441\u0432\u043E\u0438\u0445 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445.
      [redact]\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439
      \u041E\u0442\u0434\u0435\u043B[/] \u0434\u0430\u043B \u0438\u043C \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      [bold]\"\u043C\u0435\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0430\u0433\u0435\u043D\u0442\u044B\", \u0438\u043B\u0438 \"\u043C\u0435\u043C\u0430\u0433\u0435\u043D\u0442\u044B\"[/].
      \u0412 \u0434\u0430\u043D\u043D\u043E\u043C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435
      \u0432\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u043C\u0435\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0430\u0433\u0435\u043D\u0442:\n\"((\u041D\u0415\u0422
      \u041D\u0418\u0427\u0415\u0413\u041E \u041D\u041E\u0412\u041E\u0413\u041E \u041F\u041E\u0414
      \u042D\u0422\u0418\u041C \u0421\u041E\u041B\u041D\u0426\u0415\u041C))\"\n_______________________\n\n\u0412
      \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F,
      \u0432\u044B\u0434\u0430\u043D\u043D\u044B\u0435 \u0432\u0430\u043C \u0434\u043B\u044F
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430. [redact,uv]\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E[/]
      \u0431\u0443\u0434\u0435\u0442 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C,
      \u043A\u0430\u043A\u0438\u0435 \u043C\u0435\u043C\u0430\u0433\u0435\u043D\u0442\u044B
      \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u043E\u043F\u0430\u0441\u0442\u044C
      \u0432 \u043E\u0431\u0449\u0438\u0439 \u0434\u043E\u0441\u0442\u0443\u043F.\n\n[bold]\u0412\u0410\u0416\u041D\u041E[/]:
      \n- \u041C\u0435\u043C\u0430\u0433\u0435\u043D\u0442\u044B \u0432\u0441\u0435\u0433\u0434\u0430
      \u0432\u044B\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F [bold]\u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0434\u043D\u0438\u043C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C[/].\n-
      \u0417\u0430\u0434\u0430\u043D\u0438\u044F \"\u041D\u0435 \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u0439\u0442\u0435\"
      \u0438\u043C\u0435\u044E\u0442 [bold]\u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442
      \u043D\u0430\u0434 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u0437\u0430\u0434\u0430\u043D\u0438\u044F\u043C\u0438[/]. \n\n\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u0432\u044B \u0443\u0436\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438,
      \u0447\u0442\u043E \u0432\u0430\u043C \u0441\u0442\u0430\u043B \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D
      [bold]\u041A\u041E\u0414\u0415\u041A\u0421[/]. \u0412 \u043D\u0451\u043C \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
      \u0442\u0435\u0440\u043C\u0438\u043D\u043E\u043B\u043E\u0433\u0438\u044F \u0411\u044E\u0440\u043E.
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0435\u0433\u043E
      \u0434\u043B\u044F \u0443\u0442\u043E\u0447\u043D\u0435\u043D\u0438\u044F \u0441\u0432\u043E\u0435\u0433\u043E
      \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u0437\u0430\u0434\u0430\u043D\u0438\u044F.\n\n\u041D\u0430\u0447\u0438\u043D\u0430\u044F
      \u0441\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430,
      \u0432\u044B \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u0435 \u043A
      \u0441\u0432\u043E\u0435\u0439 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u0435."
