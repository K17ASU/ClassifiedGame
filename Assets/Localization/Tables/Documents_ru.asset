  m_TableData:
  - m_Id: 2300068806656
    m_Localized: "\u0423\u0427\u0415\u0411\u041D\u042B\u0419 \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 2300131721216
    m_Localized: "\u041F\u041E\u0420\u042F\u0414\u041E\u041A \u0417\u0410\u0421\u0415\u041A\u0420\u0415\u0427\u0418\u0412\u0410\u041D\u0418\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915520
    m_Localized: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0423\u0424-\u043B\u0430\u043C\u043F\u0443
      \u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u0443\u0439\u0442\u0435 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442.\n\u041D\u0430\u0439\u0434\u0438\u0442\u0435
      \u0441\u043A\u0440\u044B\u0442\u044B\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F,
      \u0437\u0430\u0442\u0435\u043C \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u0435
      \u043B\u0430\u043C\u043F\u0443\n\u0438 \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u044C\u0442\u0435
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915521
    m_Localized: "\u0421\u041B\u0423\u0416\u0415\u0411\u041D\u0410\u042F \u0417\u0410\u041F\u0418\u0421\u041A\u0410\n\n\u0412\u044B
      \u0431\u0443\u0434\u0435\u0442\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B
      \u0432 [[\u0426\u0435\u043D\u0442\u0440 \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438
      \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438]].\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u0441\u043B\u043E\u0432\u043E (\u0438\u043B\u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435
      \u043F\u043E \u0442\u0435\u043A\u0441\u0442\u0443 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F
      \u041B\u041A\u041C), \u0447\u0442\u043E\u0431\u044B \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u043F\u043B\u0430\u0448\u043A\u0443.\n\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0442\u044C \u043F\u0440\u0438
      \u043E\u0431\u044B\u0447\u043D\u043E\u043C \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0438.\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0443\u043B\u044C\u0442\u0440\u0430\u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u0443\u044E
      \u043B\u0430\u043C\u043F\u0443,\u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0439\u0442\u0438
      \u0441\u043A\u0440\u044B\u0442\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435.\n\n\u041F\u043E\u0441\u043B\u0435
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u0435
      \u043B\u0430\u043C\u043F\u0443 \u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
      \u043F\u043B\u0430\u0448\u043A\u0438 \u043D\u0430 \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0435
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915525
    m_Localized: "\u0417\u0410\u0414\u0410\u041D\u0418\u0415:\n\n\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u044C\u0442\u0435:\n-
      \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432
      \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438\n- \u0412\u0438\u0434\u044B
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439\n- \u0412\u0441\u0435
      \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915524
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C,
      \u0432 {{\u041E\u0442\u0434\u0435\u043B \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
      \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438}}, \u0430\u0433\u0435\u043D\u0442.\n\n\u0412\u0430\u0448\u0435\u0439
      \u0437\u0430\u0434\u0430\u0447\u0435\u0439 \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u0442\u044C
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B, \u0434\u043B\u044F
      \u0438\u0445 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438 {{\u0426\u0435\u043D\u0442\u0440\u043E\u043C
      \u0414\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438}}.\n
      \n\u0412 \u0441\u0432\u044F\u0437\u0438 \u0441 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u044B\u043C
      \u0440\u043E\u0441\u0442\u043E\u043C {{\u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u044B\u0445}}
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439 (\u0432 \u0442\u043E\u043C
      \u0447\u0438\u0441\u043B\u0435 \u0432\u043D\u0443\u0442\u0440\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438
      \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438), \u043A\u0430\u0436\u0434\u044B\u0439
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0434\u043E\u043B\u0436\u0435\u043D
      \u0431\u044B\u0442\u044C \u0432\u0440\u0443\u0447\u043D\u0443\u044E [[\u043E\u0442\u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D]]
      \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C\u0438 \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438.\n\n\u0414\u043B\u044F
      \u043F\u043E\u0438\u0441\u043A\u0430 {{\u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u044B\u0445}}
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B \u0432 \u0432\u0430\u0448\u0435\u043C
      \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0438.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915522
    m_Localized: "\u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422 \u2116000"
    m_Metadata:
      m_Items: []
  - m_Id: 2300135915523
    m_Localized: "\u0414\u041E\u041B\u0416\u041D\u041E\u0421\u0422\u041D\u0410\u042F
      \u0418\u041D\u0421\u0422\u0420\u0423\u041A\u0426\u0418\u042F\n"
    m_Metadata:
      m_Items: []
  - m_Id: 192118518235136
    m_Localized: "\u041E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0439
      \u043E\u0442\u0434\u0435\u043B \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435
      \u043E\u0442\r\n<<\u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430>>
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F.\r\n\r\n\u0412
      \u0436\u0443\u0440\u043D\u0430\u043B\u0435 \u0442\u0430\u043A\u0436\u0435 \u0444\u0438\u0433\u0443\u0440\u0438\u0440\u0443\u0435\u0442
      \u0441\u043B\u043E\u0432\u043E\r\n##\u041C\u0410\u042F\u041A##, \u043E\u0434\u043D\u0430\u043A\u043E
      \u0435\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435\r\n\u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C.\r\n\r\n\u041A\u043E\u0434
      \u0434\u043E\u0441\u0442\u0443\u043F\u0430 [[RX-2049]] \u0431\u044B\u043B \u043F\u0435\u0440\u0435\u0434\u0430\u043D\r\n{{\u0412\u0438\u043A\u0442\u043E\u0440\u0443
      \u041E\u0440\u043B\u043E\u0432\u0443}}."
    m_Metadata:
      m_Items: []
  - m_Id: 192010200334336
    m_Localized: "\u0422\u0415\u0421\u0422\u041E\u0412\u042B\u0419 \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 192083919421440
    m_Localized: "\u0422\u0415\u0421\u0422\u041E\u0412\u042B\u0419 \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 192144309010432
    m_Localized: "\u041D\u0430\u0432\u0435\u0434\u0438 \u043B\u0443\u043F\u0443 \u043D\u0430\n\u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430
      \u0438 \u041C\u0410\u042F\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 253372523921408
    m_Localized: "\u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422 \u2116000.1"
    m_Metadata:
      m_Items: []
  - m_Id: 253372599418880
    m_Localized: "\u0414\u041E\u041B\u0416\u041D\u041E\u0421\u0422\u041D\u0410\u042F
      \u0418\u041D\u0421\u0422\u0420\u0423\u041A\u0426\u0418\u042F\n"
    m_Metadata:
      m_Items: []
  - m_Id: 253372599418881
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u0430\u0433\u0435\u043D\u0442.\n\n\u0418\u0437\u0443\u0447\u0438\u0432 {{\u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u0443\u044E}}
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0438\u0437 \u0432\u0430\u0448\u0435\u0433\u043E
      \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430,
      \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u043F\u0440\u0438\u043D\u044F\u043B\u0430
      \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u0437 \u0442\u0430\u043A\u0438\u0445
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439 \u0434\u043B\u044F
      \u0441\u0432\u043E\u0435\u0439 \u0432\u044B\u0433\u043E\u0434\u044B. \u0412
      \u0434\u0430\u043D\u043D\u043E\u043C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435,
      \u0432\u0430\u043C \u0431\u0443\u0434\u0435\u0442 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      [[\u043C\u0435\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0430\u0433\u0435\u043D\u0442]], \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439
      \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 {{\u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u043E\u0439}}
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438: \n\u201C((\u041D\u0415\u0422
      \u041D\u0418\u0427\u0415\u0413\u041E \u041D\u041E\u0412\u041E\u0413\u041E \u041F\u041E\u0414
      \u042D\u0422\u0418\u041C \u0421\u041E\u041B\u041D\u0426\u0415\u041C))\u201D\n\n\u0412
      \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C, [[\u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F]],
      \u0432\u044B\u0434\u0430\u043D\u043D\u044B\u0435 \u0432\u0430\u043C \u0434\u043B\u044F
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430. \u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E
      \u0431\u0443\u0434\u0435\u0442 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u043A\u0430\u043A\u0438\u0435 \u043C\u0435\u043C\u0430\u0433\u0435\u043D\u0442\u044B
      \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u043E\u043F\u0430\u0441\u0442\u044C
      \u0432 \u043E\u0431\u0449\u0438\u0439 \u0434\u043E\u0441\u0442\u0443\u043F.\n\n\u041D\u0430\u0447\u0438\u043D\u0430\u044F
      \u0441\u043E \u0441\u043B\u0435\u0434\u044E\u0449\u0435\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430
      \u0432\u044B \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u0435 \u043A
      \u0441\u0432\u043E\u0435\u0439 [[\u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u0435]]."
    m_Metadata:
      m_Items: []
  - m_Id: 253372599418883
    m_Localized: "\u0417\u0410\u0414\u0410\u041D\u0418\u0415:\n\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u044C\u0442\u0435:\n-
      \u0412\u0438\u0434\u044B \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439\n-
      \u0412\u0441\u0435 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438\n\u041D\u0435 \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u0439\u0442\u0435\n-
      \u0423\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0439 \u0432 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435
      \u043C\u0435\u043C\u0430\u0433\u0435\u043D\u0442"
