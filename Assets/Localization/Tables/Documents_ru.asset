      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442
      \u0437\u0430\u043C\u0435\u043D\u0438\u043B\u0438 \u043E\u0431\u044B\u0447\u043D\u0443\u044E
      \u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0446\u0438\u044E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u0437\u0430\u043F\u0438\u0441\u044C\u044E. \u0412\u043E \u0432\u0440\u0435\u043C\u044F
      \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043B\u0438\u0441\u044C
