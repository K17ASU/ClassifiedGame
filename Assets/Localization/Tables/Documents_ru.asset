  - m_Id: 1057939662618626
    m_Localized: "\u0425\u0438\u043C\u0438\u043E\u0442\u0440\u0430\u0441\u0441\u044B
      (\u0445\u0438\u043C\u0442\u0440\u0435\u0439\u043B\u044B) \u2014 \u044D\u0442\u043E
      \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u0430\u044F \u0442\u0435\u043E\u0440\u0438\u044F
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0430. \u0421\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043A\u0438
      \u043C\u0438\u0444\u0430 \u0441\u0447\u0438\u0442\u0430\u044E\u0442, \u0447\u0442\u043E
      \u0431\u0435\u043B\u044B\u0435 \u043F\u043E\u043B\u043E\u0441\u044B \u0432
      \u043D\u0435\u0431\u0435 \u043E\u0442 \u0441\u0430\u043C\u043E\u043B\u0451\u0442\u043E\u0432
      \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0441\u043B\u0435\u0434\u0430\u043C\u0438
      [redact,magnifier]\u0442\u0430\u0439\u043D\u043E\u0433\u043E \u0440\u0430\u0441\u043F\u044B\u043B\u0435\u043D\u0438\u044F
      \u0445\u0438\u043C\u0438\u043A\u0430\u0442\u043E\u0432[/] \u0434\u043B\u044F
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F \u043A\u043B\u0438\u043C\u0430\u0442\u0430
      [redact,uv]\u0438\u043B\u0438 \u043B\u044E\u0434\u0435\u0439[/].\n\n\u042D\u0442\u0430
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0431\u044B\u043B\u0430
      \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0430
      \u0430\u0433\u0435\u043D\u0442\u0430\u043C\u0438 {{\u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438}}
      \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
      \u043D\u043E\u0432\u043E\u0441\u0442\u0438 \u043E \u0445\u0438\u043C\u0442\u0440\u0435\u0439\u043B\u0430\u0445
      \u0441\u0442\u0430\u043B\u0438 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B
      \u0441\u0440\u0435\u0434\u0438 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F
      \u0438 \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u043E\u0432. \u041F\u043E
      \u0434\u0430\u043D\u043D\u044B\u043C, \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u043C
      \u0438\u0437 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0445 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432,
      [redact,magnifier]\u043D\u0438 \u043E\u0434\u0438\u043D \u0441\u0430\u043C\u043E\u043B\u0451\u0442[/],
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0439 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0439
      \u0441\u043B\u0435\u0434, \u043D\u0435 \u0447\u0438\u0441\u043B\u0438\u0442\u0441\u044F
      \u043D\u0438 \u0432 \u043E\u0434\u043D\u043E\u0439 \u0430\u0432\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
      \u0431\u0430\u0437\u0435 \u0434\u0430\u043D\u043D\u044B\u0445. \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0431\u043E\u0440\u0442\u043E\u0432\u044B\u0435 \u043D\u043E\u043C\u0435\u0440\u0430
      \u0441\u0430\u043C\u043E\u043B\u0451\u0442\u043E\u0432, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0445
      \u0445\u0438\u043C\u0442\u0440\u0435\u0439\u043B\u044B, [uv,magnifier]\u0442\u0430\u043A\u0436\u0435
      \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C[/], \u0442\u0430\u043A
      \u043A\u0430\u043A \u043E\u043D\u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442
      [redact,uv]\u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u044B\u0435[/]
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.\n\n{{2}} \u043E\u043A\u0442\u044F\u0431\u0440\u044F
      {{2001}} \u0433\u043E\u0434\u0430 {{\u041A\u043E\u043D\u0433\u0440\u0435\u0441\u0441\u043E\u043C
      \u0421\u0428\u0410}} \u0431\u044B\u043B \u043F\u0440\u0438\u043D\u044F\u0442
      \u0430\u043A\u0442 H.R. {{2977}}, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0442\u0435\u0440\u043C\u0438\u043D \xAB\u0445\u0438\u043C\u0442\u0440\u0435\u0439\u043B\u044B\xBB
      \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u043A\u043B\u0430\u0441\u0441\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438
      \u044D\u043A\u0437\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043C
      \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F. \u041A\u043E\u043D\u0433\u0440\u0435\u0441\u0441\u043C\u0435\u043D
      {{\u042D\u043D\u0442\u043E\u043D\u0438 \u0423\u043E\u0442\u0442\u0441}}, \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0432\u0448\u0438\u0439
      \u044D\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435, \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043F\u043E\u0434 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435\u043C
      {{\u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438}}."
    m_Metadata:
      m_Items: []
  - m_Id: 1057939662618627
    m_Localized: "\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u044C\u0442\u0435:\n\n\u2022
      \u0427\u0438\u0441\u043B\u0430\n\u2022 \u0418\u043C\u0435\u043D\u0430 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435\n\u2022
      \u0410\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B\n\n\u041D\u0435
      \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u0439\u0442\u0435:\n\n\u2022
      \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438, \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u0435\u043C\u044B\u0435
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438"
