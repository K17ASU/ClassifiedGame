      \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u0439 \u043E\u0442 [redact]\u0430\u043A\u043A\u0430\u0443\u043D\u0442\u0430[/]
      [redact,uv,decoder=\u041C\u0410\u0419\u041B\u0417 \u041C\u0410\u0420\u0428]\"TheSunVanished\"[/].
      \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F \u043F\u043E\u0437\u0434\u043D\u043E
      \u0443\u0442\u0440\u043E\u043C, \u043D\u043E [redact,magnifier]\u0441\u043E\u043B\u043D\u0446\u0430[/]
      \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u0438\u0434\u043D\u043E. \u041E\u043D
      \u0434\u0435\u043B\u0438\u043B\u0441\u044F \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F\u043C\u0438
      \u0438 \u0432\u0438\u0434\u0435\u043E \u043E \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u0445
      \u0438 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044F\u0445 [redact,uv]\u043C\u0438\u0440\u0430
      \u0431\u0435\u0437 \u0441\u043E\u043B\u043D\u0446\u0430[/].\n\n\u041F\u043E\u0441\u043B\u0435
      \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u0439
      \u0418\u0418-\u0430\u0433\u0435\u043D\u0442\u044B \u0411\u044E\u0440\u043E
      \u043A\u043B\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043B\u0438
      \u0438\u0445 \u043A\u0430\u043A \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E
