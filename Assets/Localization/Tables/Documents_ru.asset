  - m_Id: 10895718273331213
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, {PLAYER_NAME}.\n\n\u0415\u0441\u043B\u0438
      \u0442\u044B \u0447\u0438\u0442\u0430\u0435\u0448\u044C \u044D\u0442\u043E,
      \u0437\u043D\u0430\u0447\u0438\u0442 \"\u0421\u041C\u041E\u0422\u0420\u0418\u0422\u0415\u041B\u042C\"
      \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F.\n\n\u042F \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u044D\u0442\u0443 \u0437\u0430\u043F\u0438\u0441\u044C \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439,
      \u0435\u0441\u043B\u0438 \u0447\u0430\u0441\u0442\u044C \u0442\u0432\u043E\u0435\u0439
      \u043F\u0430\u043C\u044F\u0442\u0438 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430.\n\n\u0422\u044B
      \u0432\u044B\u0437\u0432\u0430\u043B\u0441\u044F \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u0435\u043C.\n\n\u042D\u0442\u043E
      \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0431\u044B\u043B\u043E \u0442\u0432\u043E\u0438\u043C.
      \u042F \u043E\u0431\u0435\u0449\u0430\u043B \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0442\u0435\u0431\u0435 \u0445\u043E\u0442\u044F \u0431\u044B \u044D\u0442\u043E
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435.\n\n\u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435,
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0443\u0436\u0435 \u043D\u0435
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C. \u041D\u043E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439,
      \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u0442\u044B \u0432\u0441\u0435
      \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u043C\u043D\u0438\u0448\u044C -
      \u0437\u0430\u0447\u0435\u043C \u043C\u044B \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B\u0438.\n\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E.\n\n\u0422\u0432\u043E\u0439
      \u0434\u0440\u0443\u0433,\n\u041C\u0430\u0439\u043B\u0437"
    m_Metadata:
      m_Items: []
