  - m_Id: 1057959841415168
    m_Localized: "\u0412\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435
      \u0441\u0435\u0431\u044F, \u0430\u0433\u0435\u043D\u0442.\n\n\u0412 \u0441\u0432\u044F\u0437\u0438
      \u0441 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u0443\u0442\u0435\u0447\u043A\u0430\u043C\u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
      \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E
      \u041A\u0443\u043B\u044C\u0442\u0430 \u0417\u0432\u0435\u0437\u0434\u043E\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u044B\u0445
      \u0432\u043D\u0443\u0442\u0440\u0438 \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
      \u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u043F\u0440\u0438\u043D\u044F\u043B\u043E
      \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043D\u043E\u0432\u044B\u0439 \u043C\u0435\u043C\u0430\u0433\u0435\u043D\u0442,
      \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430: [bold]\"\u0428\u0418\u0424\u0420\"[/].\n\n\u0412
      \u0432\u0430\u0448\u0435 [redact]\u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0435[/]
      \u0432\u044B\u0434\u0430\u043D \u043D\u043E\u0432\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u2014 [bold]\u0434\u0435\u043A\u043E\u0434\u0435\u0440[/], \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442 \u0432\u044B\u044F\u0432\u043B\u044F\u0442\u044C
      \u0448\u0438\u0444\u0440\u044B \u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C
      \u0438\u0445 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435.\n\n\u0414\u043B\u044F
      \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B
      \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u0434\u0435\u043A\u043E\u0434\u0435\u0440
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u0444\u0440\u0430\u0437\u0443:\n[decoder=\u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0435]\u0412\u0421\u0401
      \u0422\u0410\u0419\u041D\u041E\u0415 \u0421\u0422\u0410\u041D\u0415\u0422 \u042F\u0412\u042C\u042E[/]\n\n\u0418
      \u0437\u0430\u0448\u0438\u0444\u0440\u0443\u0439\u0442\u0435 \u0441\u043B\u043E\u0432\u043E,
      \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0435 \u0432 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0435.\n\n[bold]\u0412\u0410\u0416\u041D\u041E[/]:
      \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
      \"\u0428\u0418\u0424\u0420\" \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D \u041A\u0443\u043B\u044C\u0442\u043E\u043C
      \u0417\u0432\u0435\u0437\u0434\u043E\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u044B\u0445
      \u043F\u0440\u043E\u0442\u0438\u0432 \u0432\u0430\u0441. \u041F\u043E\u043C\u043D\u0438\u0442\u0435:
      \u0432\u0430\u0448\u0438 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0438\u043C\u0435\u044E\u0442
      \u0441\u0430\u043C\u044B\u0439 \u0432\u044B\u0441\u043E\u043A\u0438\u0439 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442."
