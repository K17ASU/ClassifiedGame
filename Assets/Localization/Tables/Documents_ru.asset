    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, {PLAYER_NAME}.\n\n\u0415\u0441\u043B\u0438
      \u0442\u044B \u0447\u0438\u0442\u0430\u0435\u0448\u044C \u044D\u0442\u043E,
      \u0437\u043D\u0430\u0447\u0438\u0442 \"\"\u0421\u041C\u041E\u0422\u0420\u0418\u0422\u0415\u041B\u042C\"\"
      \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F.\n\n\u042F \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u044D\u0442\u0443 \u0437\u0430\u043F\u0438\u0441\u044C \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439,
      \u0435\u0441\u043B\u0438 \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u0442\u044B
      \u043D\u0430\u0447\u043D\u0435\u0448\u044C \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C.\n\n[cycle=\u0422\u044B \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F
      \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E|\u0420\u0435\u0448\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u043D\u044F\u043B\u043E \u0411\u044E\u0440\u043E|\u0421\u0442\u0430\u0442\u0443\u0441
      \u0443\u0447\u0430\u0441\u0442\u0438\u044F \u0443\u0442\u0440\u0430\u0447\u0435\u043D|\u0417\u0430\u043F\u0438\u0441\u044C
      \u0431\u044B\u043B\u0430 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0430,interval=1.2-2.4]\u0421\u0442\u0430\u0442\u0443\u0441
      \u0443\u0447\u0430\u0441\u0442\u0438\u044F \u0443\u0442\u0440\u0430\u0447\u0435\u043D[/]\n\n\u041C\u043D\u0435
      \u0436\u0430\u043B\u044C...\n\n\u041D\u043E \u0435\u0441\u043B\u0438 \u0442\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0448\u044C \u044D\u0442\u0443
      \u0440\u0430\u0431\u043E\u0442\u0443, \u0437\u043D\u0430\u0447\u0438\u0442
      \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u0447\u0430\u0441\u0442\u044C
      \u0442\u0435\u0431\u044F \u0432\u0441\u0435 \u0435\u0449\u0435 \u043F\u043E\u043C\u043D\u0438\u0442,
      \u0447\u0442\u043E \u043C\u044B \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
      \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C.\n\n\u0411\u0435\u0440\u0435\u0433\u0438
      \u0438\u0445.\n\n\u041C\u0430\u0439\u043B\u0437"
    m_Metadata:
