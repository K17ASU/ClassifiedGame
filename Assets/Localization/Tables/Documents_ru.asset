  - m_Id: 1737425051762688
    m_Localized: "\u0412\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0435\u0441\u044C,
      {PLAYER_NAME}.\n\n\u0414\u043B\u044F \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u0432\u0430\u0448\u0435 \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0435
      \u0431\u044B\u043B \u0432\u044B\u0434\u0430\u043D \u043D\u043E\u0432\u044B\u0439
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u2014 [bold]\"\u041B\u0438\u043D\u0437\u0430\"[/].\n\n\u041B\u0438\u043D\u0437\u0430
      \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442 \u0432\u0430\u043C \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C
      \u0432 \u0442\u0435\u043A\u0441\u0442\u0435 \u043D\u043E\u0432\u044B\u0439
      \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
      \u2014 [bold]\"\u041A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u0430\u044F
      \u0443\u0433\u0440\u043E\u0437\u0430\"[/].\n\n\u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435
      \u043B\u0438\u043D\u0437\u0443 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0442\u0435\u043A\u0441\u0442:\n\"[redact,magnifier]\u041C\u042B \u0414\u0412\u0418\u0416\u0415\u041C\u0421\u042F
      \u041F\u041E\u0414 \u0415\u0413\u041E \u0412\u0417\u041E\u0420\u041E\u041C[/]\"\n\n\u0418\u043C\u0435\u043D\u043D\u043E
      \u0442\u0430\u043A \u0431\u0443\u0434\u0443\u0442 \u0432\u044B\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u044B\u0435 \u0443\u0433\u0440\u043E\u0437\u044B.
      \u0423\u0447\u0442\u0438\u0442\u0435, \u0447\u0442\u043E \u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u0430\u044F
      \u0443\u0433\u0440\u043E\u0437\u0430 \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0430
      \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043C\u0435\u043C\u0430\u0433\u0435\u043D\u0442\u0430.\n\n\u0414\u043B\u044F
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u044C\u0442\u0435
      \u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u0443\u044E \u0443\u0433\u0440\u043E\u0437\u0443
      \u0432 \u044D\u0442\u043E\u043C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435
      \u0438 \u043E\u0442\u0434\u0430\u0439\u0442\u0435 \u0435\u0433\u043E \u043D\u0430
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443."
