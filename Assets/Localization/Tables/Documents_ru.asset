  - m_Id: 10913412359991297
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, {PLAYER_NAME}.\n\n\u0415\u0441\u043B\u0438
      \u0442\u044B \u0447\u0438\u0442\u0430\u0435\u0448\u044C \u044D\u0442\u043E,
      \u0437\u043D\u0430\u0447\u0438\u0442 \"\u0421\u041C\u041E\u0422\u0420\u0418\u0422\u0415\u041B\u042C\"
      \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B \u0441\u0432\u043E\u044E \u0437\u0430\u0434\u0430\u0447\u0443,
      \u0430 \u043D\u0430\u0441 \u0441 \u0442\u043E\u0431\u043E\u0439 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435\u0442 \u0441\u0440\u0435\u0434\u0438 \u043B\u044E\u0434\u0435\u0439.\n\n\u0414\u0430\u0436\u0435
      \u043A\u0430\u043A-\u0442\u043E \u0433\u0440\u0443\u0441\u0442\u043D\u043E,
      \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430 \u043B\u0438? \u041D\u0438
      \u0442\u044B, \u043D\u0438 \u044F \u0443\u0436\u0435 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0443\u0432\u0438\u0434\u0438\u043C \u043F\u043B\u043E\u0434\u044B
      \u043D\u0430\u0448\u0438\u0445 \u0442\u0440\u0443\u0434\u043E\u0432 \u0441\u0432\u043E\u0438\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438.\n\n\u0422\u0435\u043C \u043D\u0435
      \u043C\u0435\u043D\u0435\u0435, \u043C\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0442\u043E, \u0447\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u043B\u0438
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C.\n\n\u042F \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D
      \u0442\u0435\u0431\u0435 \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u0442\u044B
      \u0432\u044B\u0437\u0432\u0430\u043B\u0441\u044F \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u0435\u043C
      \u0434\u043B\u044F \u0443\u0447\u0430\u0441\u0442\u0438\u044F \u0432 \u043F\u0440\u043E\u0435\u043A\u0442\u0435
      \"\u0421\u041C\u041E\u0422\u0420\u0418\u0422\u0415\u041B\u042C\". \u041D\u0430\u0439\u0442\u0438
      \u043A\u0430\u043D\u0434\u0438\u0434\u0430\u0442\u0430 \u043B\u0443\u0447\u0448\u0435
      \u0442\u0435\u0431\u044F, \u043F\u043E\u0436\u0430\u043B\u0443\u0439, \u0431\u044B\u043B\u043E
      \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E.\n\n\u0412 \u043A\u043E\u043D\u0446\u0435
      \u043A\u043E\u043D\u0446\u043E\u0432, \u043A\u0442\u043E \u043B\u0443\u0447\u0448\u0435
      \u043F\u043E\u0434\u043E\u0439\u0434\u0435\u0442 \u043D\u0430 \u0440\u043E\u043B\u044C
      \u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044F, \u0447\u0435\u043C
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440
      \u0411\u044E\u0440\u043E?\n\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E.\n\n\u0422\u0432\u043E\u0439
      \u0434\u0440\u0443\u0433,\n\u041C\u0430\u0439\u043B\u0437\n"
    m_Metadata:
      m_Items: []
