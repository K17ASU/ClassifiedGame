  - m_Id: 253372599418881
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u0430\u0433\u0435\u043D\u0442.\n\n\u0418\u0437\u0443\u0447\u0438\u0432 {{\u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u0443\u044E}}
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0438\u0437 \u0432\u0430\u0448\u0435\u0433\u043E
      \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430,
      \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u043F\u0440\u0438\u043D\u044F\u043B\u0430
      \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0432 \u0441\u0432\u043E\u0438\u0445
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445. \u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439
      \u041E\u0442\u0434\u0435\u043B \u0434\u0430\u043B \u0438\u043C \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \xAB\u043C\u0435\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0430\u0433\u0435\u043D\u0442\u044B\xBB, \u0438\u043B\u0438 \xAB\u043C\u0435\u043C\u0430\u0433\u0435\u043D\u0442\u044B\xBB.
      \u0412 \u0434\u0430\u043D\u043D\u043E\u043C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435
      \u0432\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      [[\u043C\u0435\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0430\u0433\u0435\u043D\u0442]], \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439
      \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 {{\u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u043E\u0439}}
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438:\n\xAB((\u041D\u0415\u0422
      \u041D\u0418\u0427\u0415\u0413\u041E \u041D\u041E\u0412\u041E\u0413\u041E \u041F\u041E\u0414
      \u042D\u0422\u0418\u041C \u0421\u041E\u041B\u041D\u0426\u0415\u041C))\xBB\n\n\u0412
      \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C [[\u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F]],
      \u0432\u044B\u0434\u0430\u043D\u043D\u044B\u0435 \u0432\u0430\u043C \u0434\u043B\u044F
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430. \u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E
      \u0431\u0443\u0434\u0435\u0442 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C,
      \u043A\u0430\u043A\u0438\u0435 \u043C\u0435\u043C\u0430\u0433\u0435\u043D\u0442\u044B
      \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u043E\u043F\u0430\u0441\u0442\u044C
      \u0432 \u043E\u0431\u0449\u0438\u0439 \u0434\u043E\u0441\u0442\u0443\u043F.\n\n\u041D\u0430\u0447\u0438\u043D\u0430\u044F
      \u0441\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430
      \u0432\u044B \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u0435 \u043A
      \u0441\u0432\u043E\u0435\u0439 [[\u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u0435]]."
    m_Metadata:
      m_Items: []
  - m_Id: 253372599418883
    m_Localized: "\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0442\u044C\u0442\u0435:\n\n\u2022
      \u0412\u0438\u0434\u044B \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439\n\u2022
      \u0410\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B\n\n\u041D\u0435
      \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u0439\u0442\u0435:\n\n\u2022
      \u0423\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0439 \u0432 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435
      \u043C\u0435\u043C\u0430\u0433\u0435\u043D\u0442"
    m_Metadata:
