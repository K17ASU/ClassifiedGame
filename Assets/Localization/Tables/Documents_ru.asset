  - m_Id: 1057859891150849
    m_Localized: "\u0412 {{2015}} \u0433\u043E\u0434\u0443 \u043D\u0435\u043A\u0438\u0439
      \u0431\u043B\u043E\u0433\u0435\u0440 \u043F\u043E\u0434 \u043F\u0441\u0435\u0432\u0434\u043E\u043D\u0438\u043C\u043E\u043C
      \"searchandrescuewoods\" \u0441 \u0441\u0430\u0439\u0442\u0430 Reddit \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u043B
      \u0441\u043B\u0443\u0447\u0430\u0438 \u0438\u0437 \u0441\u0432\u043E\u0435\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u043E-\u0441\u043F\u0430\u0441\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u0441\u043B\u0443\u0436\u0431\u0435 \u043F\u0430\u0440\u043A\u043E\u0432\u044B\u0445
      \u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440\u043E\u0432 \u0421\u0428\u0410,
      \u0430 \u0442\u0430\u043A\u0436\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B
      \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0441\u0432\u043E\u0438\u0445 \u043A\u043E\u043B\u043B\u0435\u0433.\n\n\u0412
      \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0441\u0432\u043E\u0438\u0445
      \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u0439 \u043E\u043D \u043F\u0438\u0441\u0430\u043B:
      \"\u041A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430
      \u043C\u044B \u0431\u044B\u043B\u0438 \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438
      {{50\u201360}} \u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440\u043E\u0432
      \u043E\u0442 \u0431\u0430\u0437\u044B, \u0432 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
      \u043C\u043E\u043C\u0435\u043D\u0442 \u043C\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438
      \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0443 \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u043B\u0435\u0441\u0430. \u041A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u043A\u0442\u043E-\u0442\u043E \u0432\u0437\u044F\u043B \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0443
      \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u043C \u0434\u043E\u043C\u0435,
      [redact,magnifier,uv]\u0432\u044B\u0440\u0435\u0437\u0430\u043B \u0435\u0451
      \u043E\u0442\u0442\u0443\u0434\u0430[/] \u0438 [redact,magnifier]\u0432\u0441\u0442\u0430\u0432\u0438\u043B[/]
      \u0432 \u043B\u0435\u0441. \u041A\u043E\u0433\u0434\u0430 \u044F \u043F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0430\u0437 \u0443\u0432\u0438\u0434\u0435\u043B \u0435\u0451, \u0443
      \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u043E \u043C\u043D\u043E\u0433\u043E
      [redact,uv]\u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432[/], \u043D\u043E
      \u043C\u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E
      \u044D\u0442\u043E \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u0432\u0435\u0449\u0435\u0439.
      \u0422\u0435\u043F\u0435\u0440\u044C \u044F \u043F\u0440\u043E\u0441\u0442\u043E
      [redact,magnifier]\u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u044E[/]
      \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u044B, \u043A\u043E\u0433\u0434\u0430
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E \u0438\u0445: \u044D\u0442\u043E
      \u0441\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F [redact,uv]\u043E\u0447\u0435\u043D\u044C
      \u0447\u0430\u0441\u0442\u043E[/]\".\n\n\u0414\u0430\u043D\u043D\u0430\u044F
      \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u044F \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B\u0430
      \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044E. \u0410\u0433\u0435\u043D\u0442\u044B
      [redact,decoder=\u0432\u0430\u043C \u043D\u0435 \u0441\u043A\u0440\u044B\u0442\u044C\u0441\u044F]\u043F\u043E\u0434
      \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0438\u0435\u043C[/] \u0431\u044B\u043B\u0438
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B \u0432 \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
      \u043F\u0430\u0440\u043A\u0438 [magnifier]\u0421\u0428\u0410[/] \u0434\u043B\u044F
      \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0433\u043E \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F.
      \u041F\u043E \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u043C \u0438\u043C\u0438
      \u0434\u0430\u043D\u043D\u044B\u043C, \u044D\u0442\u0438 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u044B
      \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u043A\u0430\u043A \"[redact,magnifier]\u043F\u043E\u0440\u0442\u0430\u043B\u044B[/]\"
      \u0432 \u0434\u0440\u0443\u0433\u0438\u0435 [redact,uv]\u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F[/].
      \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, {{\u043E\u0434\u0438\u043D}}
      [redact,decoder=\u041C\u0430\u0439\u043B\u0437 \u041C\u0430\u0440\u0448]\u0430\u0433\u0435\u043D\u0442[/],
      \u043D\u0430\u0445\u043E\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044F \u0432
      \u043F\u0430\u0440\u043A\u0435 [uv]\u0419\u043E\u0441\u0435\u043C\u0438\u0442\u0438[/],
      \u0441\u043E\u043E\u0431\u0449\u0438\u043B, \u0447\u0442\u043E \u0435\u0433\u043E
      \u043A\u043E\u043B\u043B\u0435\u0433\u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B\u0438:
      \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0442\u0430\u043A\u0443\u044E \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0443,
      \u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0434\u043E\u0439\u0442\u0438
      \u043A \u043D\u0435\u0439 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0431\u043B\u0438\u0437\u043A\u043E, \u044D\u0442\u043E \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0451\u0442
      \u0431\u0435\u0434\u0443.\n\n\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u0434\u043D\u043E\u0439
      \u0438\u0437 \u0441\u043F\u0430\u0441\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u0430\u0433\u0435\u043D\u0442\u0443
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0442\u044C
      \u043E\u0434\u043D\u0443 \u0438\u0437 \u0442\u0430\u043A\u0438\u0445 \u043B\u0435\u0441\u0442\u043D\u0438\u0446,
      \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u0438\u0437 {{5}} \u043F\u0440\u043E\u043B\u0451\u0442\u043E\u0432.
      \u041F\u0440\u0438 \u0435\u0451 \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0438
      \u043E\u043D \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B \u0443
      \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u0441\u0438\u043C\u0432\u043E\u043B
      [redact,uv,magnifier,decoder=\u041A\u0443\u043B\u044C\u0442\u0430 \u0417\u0432\u0435\u0437\u0434\u043E\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u044B\u0445]\u0432
      \u0432\u0438\u0434\u0435 \u0437\u0432\u0435\u0437\u0434\u044B[/], \u043E \u0447\u0451\u043C
      \u0441\u0440\u0430\u0437\u0443 \u0441\u043E\u043E\u0431\u0449\u0438\u043B \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438.
