  - m_Id: 192083919421440
    m_Localized: "\u0422\u0415\u0421\u0422\u041E\u0412\u042B\u0419 \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 192144309010432
    m_Localized: "\u043D\u0435\u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u2014 \u0434\u043B\u0438\u043D\u043D\u043E\u0435 UV-\u0441\u043B\u043E\u0432\u043E;\n\u043C\u0438\u043A\u0440\u043E\u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
      \u2014 \u0434\u043B\u0438\u043D\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E
      \u0434\u043B\u044F \u043B\u0443\u043F\u044B;\n\u0421\u0415\u041A\u0422\u041E\u0420-\u0410\u041B\u042C\u0424\u0410-7291
      \u2014 \u0431\u0443\u043A\u0432\u044B + \u0434\u0435\u0444\u0438\u0441\u044B
      + \u0446\u0438\u0444\u0440\u044B;\n\u042D\u041A\u0421\u041F\u0415\u0420\u0418\u041C\u0415\u041D\u0422\u0410\u041B\u042C\u041D\u042B\u0419-\u041C\u041E\u0414\u0423\u041B\u042C-\u041E\u041C\u0415\u0413\u0410
      \u2014 \u0434\u043B\u0438\u043D\u043D\u0430\u044F \u043A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
      \u0441\u0442\u0440\u043E\u043A\u0430."
