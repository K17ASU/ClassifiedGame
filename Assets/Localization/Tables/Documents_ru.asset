  - m_Id: 10916838275887106
    m_Localized: "\u0423\u0412\u0415\u0414\u041E\u041C\u041B\u0415\u041D\u0418\u0415
      \u041E \u0414\u041E\u041F\u0423\u0421\u041A\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 10916838275887107
    m_Localized: "\u041C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435
      \u0432 \u0434\u0430\u043D\u043D\u043E\u043C \u0430\u0440\u0445\u0438\u0432\u0435,
      \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0432\u044B\u043C\u044B\u0441\u043B\u043E\u043C.\n\n\u041E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u043C\u043E\u0433\u0443\u0442
      \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F
      \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0441\u043E\u0431\u044B\u0442\u0438\u0439, \u043B\u0438\u0446, \u043C\u0435\u0441\u0442
      \u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0439.
      \u0418\u0445 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
      \u043D\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043E
      \u043E\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435 \u0432 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u0445
      \u0441\u043E\u0431\u044B\u0442\u0438\u044F \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u0438
      \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.\n\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442
      \u0442\u0435\u043C\u044B \u0438 \u043E\u0431\u0440\u0430\u0437\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043C\u043E\u0433\u0443\u0442 \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u0442\u0440\u0435\u0432\u043E\u0433\u0443
      \u0438\u043B\u0438 \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442.\n\n\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0441 \u0430\u0440\u0445\u0438\u0432\u043E\u043C,
      \u0432\u044B \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0435,
      \u0447\u0442\u043E \u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0438\u0441\u044C
      \u0441 \u0434\u0430\u043D\u043D\u044B\u043C \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435\u043C
      \u0438 \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439 \u0434\u043E\u0441\u0442\u0443\u043F
      \u043A \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C.\n\n\u0412
      \u0441\u043B\u0443\u0447\u0430\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044F
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435:\n\n\u041F\u0415\u0420\u0415\u0414\u0410\u0419\u0422\u0415
      \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422\n\n\u041E\u0442\u043A\u0430\u0437
      \u043E\u0442 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044F \u043D\u0435
      \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0430\u0435\u0442 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430
      \u043E\u0442 \u043E\u0437\u043D\u0430\u043A\u043E\u043C\u043B\u0435\u043D\u0438\u044F
      \u0441 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10916838275887108
    m_Localized: "\u0412\u042B \u0421\u041E\u0413\u041B\u0410\u0421\u041D\u042B \u041E\u0422\u0414\u0410\u0422\u042C
      \u0421\u0415\u0411\u042F \u0426\u0415\u041B\u0418\u041A\u041E\u041C \u041D\u0410
      \u0411\u041B\u0410\u0413\u041E \u0427\u0415\u041B\u041E\u0412\u0415\u0427\u0415\u0421\u0422\u0412\u0410"
