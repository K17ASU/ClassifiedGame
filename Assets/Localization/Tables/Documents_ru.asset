      \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0435\u0439 \u0441\u043B\u0443\u0447\u0430\u0439
      \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 [redact,magnifier,uv]\u043A\u0443\u043B\u044C\u0442\u0430[/],
      \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0432\u0448\u0435\u0433\u043E
      \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0428\u043E\u0442\u043B\u0430\u043D\u0434\u0438\u0438."
