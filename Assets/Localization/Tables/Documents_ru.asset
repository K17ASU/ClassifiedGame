      \u0417\u0432\u0435\u0437\u0434\u043E\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u044B\u0445[/].\n\n\u0410\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u041E\u0442\u0434\u0435\u043B \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B,
      \u0447\u0442\u043E \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
      \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u044C
      \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u0438\u0433\u043D\u0430\u043B\u0430
      \u0431\u044B\u043B\u0430 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0430
      \u043D\u0435 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u0438\u043E\u043D\u043D\u044B\u0445
      \u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0446\u0438\u0439, \u0430 \u0441\u043F\u0443\u0441\u0442\u044F
