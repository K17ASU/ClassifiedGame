  - m_Id: 1057959841415168
    m_Localized: "\u0412\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435
      \u0441\u0435\u0431\u044F, \u0430\u0433\u0435\u043D\u0442.\n\n\u0412 \u0432\u0430\u0448\u0435
      [redact]\u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0435[/]
      \u0432\u044B\u0434\u0430\u043D \u043D\u043E\u0432\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442:
      \u0434\u0435\u043A\u043E\u0434\u0435\u0440.\n\n\u0414\u043B\u044F \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435
      \u0434\u0435\u043A\u043E\u0434\u0435\u0440 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
      \u0444\u0440\u0430\u0437\u0443:\n[decoder=\u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0435]\u041D\u0415\u0422
      \u041D\u0418\u0427\u0415\u0413\u041E \u041D\u041E\u0412\u041E\u0413\u041E \u041F\u041E\u0414
      \u042D\u0422\u0418\u041C \u0421\u041E\u041B\u041D\u0426\u0415\u041C[/]\n\n\u0418
      \u043E\u0442\u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u0443\u0439\u0442\u0435
      \u0441\u043B\u043E\u0432\u043E, \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0435
      \u0432 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1057959841415169
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0434\u0435\u043A\u043E\u0434\u0435\u0440 \u043D\u0430 \u043A\u043E\u0434\u043E\u0432\u043E\u0439
      \u0444\u0440\u0430\u0437\u0435.\n\u041E\u0442\u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u0443\u0439\u0442\u0435
      \u0441\u043B\u043E\u0432\u043E, \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0435
      \u0432 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0435."
