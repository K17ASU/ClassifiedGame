  m_TableData:
  - m_Id: 472019156992
    m_Localized: "\u041E\u0422\u0414\u0415\u041B \u0417\u0410\u0421\u0415\u041A\u0420\u0415\u0427\u0418\u0412\u0410\u041D\u0418\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 472035934208
    m_Localized: "\u0421\u041B\u0423\u0416\u0415\u0411\u041D\u0410\u042F \u0421\u0418\u0421\u0422\u0415\u041C\u0410
      \u041E\u0411\u0420\u0410\u0411\u041E\u0422\u041A\u0418 \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422\u041E\u0412"
    m_Metadata:
      m_Items: []
  - m_Id: 472035934209
    m_Localized: "\u041D\u041E\u0412\u0410\u042F \u0418\u0413\u0420\u0410"
