    m_Metadata:
      m_Items: []
  - m_Id: 472035934211
    m_Localized: "\u041C\u0415\u041D\u042E"
    m_Metadata:
      m_Items: []
  - m_Id: 472035934212
    m_Localized: "\u041F\u0415\u0420\u0415\u0414\u0410\u0422\u042C \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 472035934213
    m_Localized: "\u0423\u0424-\u041B\u0410\u041C\u041F\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 472035934214
    m_Localized: "\u0412\u042B\u041A\u041B\u042E\u0427\u0418\u0422\u042C \u041B\u0410\u041C\u041F\u0423"
    m_Metadata:
      m_Items: []
  - m_Id: 14569246867456
    m_Localized: "\u0414\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 14593347338240
    m_Localized: "\u041D\u0415\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 14625563787264
    m_Localized: "\u041D\u0410\u0427\u0410\u0422\u042C \u0417\u0410\u041D\u041E\u0412\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 14760414855168
    m_Localized: "\u041F\u0420\u0415\u0420\u0412\u0410\u0422\u042C \u041E\u0411\u0420\u0410\u0411\u041E\u0422\u041A\u0423?"
    m_Metadata:
      m_Items: []
  - m_Id: 14856661549056
    m_Localized: "\u0422\u0435\u043A\u0443\u0449\u0438\u0439 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441
      \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043D.\\n\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 83280863477760
    m_Localized: "\u0421\u041B\u0415\u0414\u0423\u042E\u0429\u0418\u0419 \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 83517137010688
    m_Localized: "\u041F\u0420\u0418\u0421\u0422\u0423\u041F\u0418\u0422\u042C \u041A
      \u0420\u0410\u0411\u041E\u0422\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 110460536406016
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F
      \u0434\u043B\u044F \u0437\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0438\u0432\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320576
    m_Localized: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0438\u0437\u043C\u0435\u043D\u0451\u043D.
      \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0435\u0449\u0451 \u043D\u0435
      \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320577
    m_Localized: "\u0423\u043B\u044C\u0442\u0440\u0430\u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u0430\u044F
      \u043B\u0430\u043C\u043F\u0430 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0430.
      \u0418\u0441\u0441\u043B\u0435\u0434\u0443\u0439\u0442\u0435 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320578
    m_Localized: "\u041B\u0430\u043C\u043F\u0430 \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u0430.
      \u041C\u043E\u0436\u043D\u043E \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
      \u043F\u043B\u0430\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320579
    m_Localized: "\u0423\u0427\u0415\u0411\u041D\u042B\u0419 \u0420\u0415\u0416\u0418\u041C"
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320580
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E. \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \xAB\u041F\u0415\u0420\u0415\u0414\u0410\u0422\u042C \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320581
    m_Localized: "\u0412\u044B \u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u043B\u0438\u0448\u043D\u0435\u0435
      \u0441\u043B\u043E\u0432\u043E. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u043F\u043B\u0430\u0448\u043A\u0443 \u0435\u0449\u0451 \u0440\u0430\u0437,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0431\u0440\u0430\u0442\u044C \u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320582
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435
      \u043F\u043E\u0438\u0441\u043A \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0445
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320583
    m_Localized: "\u041E\u0411\u0423\u0427\u0415\u041D\u0418\u0415\\n\u0417\u0410\u0412\u0415\u0420\u0428\u0415\u041D\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320584
    m_Localized: "\u0412\u0421\u0415 \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422\u042B\\n\u041E\u0411\u0420\u0410\u0411\u041E\u0422\u0410\u041D\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320585
    m_Localized: "\u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422 \u041F\u0420\u0418\u041D\u042F\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320586
    m_Localized: "\u041E\u0411\u0420\u0410\u0411\u041E\u0422\u041A\u0410\\n\u0417\u0410\u0412\u0415\u0420\u0428\u0415\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320587
    m_Localized: "\u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422 \u041F\u0420\u041E\u0412\u0410\u041B\u0415\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320588
    m_Localized: "\u0423\u0447\u0435\u0431\u043D\u044B\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442
      \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D.\\n\u0412\u044B \u0433\u043E\u0442\u043E\u0432\u044B
      \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u043A \u0440\u0430\u0431\u043E\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 110460599320589
    m_Localized: "\u041E\u0411\u0423\u0427\u0415\u041D\u0418\u0415\\n\u0417\u0430\u0441\u0435\u043A\u0440\u0435\u0447\u0435\u043D\u043E
